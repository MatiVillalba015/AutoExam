<!--
    Paleta clara. Papel frio en vez de blanco puro, por el mismo motivo que la
    oscura evita el negro: bajar el contraste bruto del fondo sin perder
    legibilidad. Las claves son identicas a las de Tokens.Oscuro.xaml, asi que
    cambiar de tema es intercambiar este diccionario y nada mas.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Superficies: gris con temperatura violeta sutil (mismo matiz que PincelMarca), para
         que el morado predomine tambien fuera de los acentos -->
    <SolidColorBrush x:Key="PincelFondo" Color="#E6E4EF" />
    <SolidColorBrush x:Key="PincelSuperficie" Color="#F5F4F8" />
    <SolidColorBrush x:Key="PincelTarjeta" Color="#FAFAFB" />
    <SolidColorBrush x:Key="PincelTarjetaHover" Color="#DFDDEB" />
    <SolidColorBrush x:Key="PincelBorde" Color="#CDCADD" />
    <SolidColorBrush x:Key="PincelBordeFuerte" Color="#A5A0C5" />

    <!-- Texto -->
    <SolidColorBrush x:Key="PincelTexto" Color="#1A1D26" />
    <SolidColorBrush x:Key="PincelTextoSuave" Color="#5A6273" />
    <SolidColorBrush x:Key="PincelTextoTenue" Color="#767E8E" />

    <!-- Marca -->
    <SolidColorBrush x:Key="PincelMarca" Color="#6246C8" />
    <SolidColorBrush x:Key="PincelMarcaFuerte" Color="#4F38AA" />
    <SolidColorBrush x:Key="PincelMarcaSuave" Color="#EEEAFB" />
    <SolidColorBrush x:Key="PincelSobreMarca" Color="#FFFFFF" />

    <!--
        US-043 — la superficie de una tarjeta que se elige. Mismo recurso que en el tema
        oscuro, en el rango claro: sobre papel el volumen viene de que el borde inferior se
        apoya en un gris apenas mas frio, nunca de oscurecer la tarjeta entera.
    -->
    <LinearGradientBrush x:Key="PincelTarjetaProfunda" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#F1F0F6" />
    </LinearGradientBrush>

    <!--
        US-041 — el cuadrado del icono de cada tarjeta del menu. Mismo degradado violeta que en
        el tema oscuro, pero en el rango claro: sobre papel el cuadrado tiene que quedar mas
        claro que la tarjeta, no mas oscuro, o el icono se vuelve una mancha.
    -->
    <LinearGradientBrush x:Key="PincelIconoAccion" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E7E1FA" />
        <GradientStop Offset="1" Color="#D6CDF3" />
    </LinearGradientBrush>

    <!-- Semantica de correccion: fija, nunca se reutiliza para decorar. Mismo matiz que antes
         (verde/rojo/ambar, nunca corrido hacia el violeta) — solo se ajusto luminancia/
         saturacion para que Acierto/Error/Pendiente se distingan entre si (NFR-33/AC-T39).
         PincelPendienteSuave se oscurecio (dejo de ser un pastel casi blanco) porque Pendiente
         necesita ser el mas claro de los tres para separarse de Acierto y Error; contra un
         "Suave" casi blanco esa combinacion no llegaba a 3:1. -->
    <SolidColorBrush x:Key="PincelAcierto" Color="#018453" />
    <SolidColorBrush x:Key="PincelAciertoSuave" Color="#E4F5EC" />
    <SolidColorBrush x:Key="PincelError" Color="#570003" />
    <SolidColorBrush x:Key="PincelErrorSuave" Color="#FCEAEA" />
    <SolidColorBrush x:Key="PincelPendiente" Color="#FFCA65" />
    <SolidColorBrush x:Key="PincelPendienteSuave" Color="#88661D" />

    <!--
        Tres niveles de profundidad, no uno (US-030).

        El criterio pide que una tarjeta informativa, una seleccionable y un resumen final no
        se vean todas iguales. Sobre papel la diferencia tiene que ser de grado y no de clase:
        si el escalon entre niveles es grande, la pantalla se llena de recortes flotando. Lo
        que cambia entre los tres es el difuminado y la opacidad; la direccion y el color son
        siempre los mismos, para que la luz venga de un solo lado en toda la app.
    -->
    <DropShadowEffect x:Key="SombraTarjetaSuave" BlurRadius="10" ShadowDepth="1" Direction="270"
                      Color="#2A3040" Opacity="0.08" />

    <DropShadowEffect x:Key="SombraTarjeta" BlurRadius="18" ShadowDepth="2" Direction="270"
                      Color="#2A3040" Opacity="0.13" />

    <DropShadowEffect x:Key="SombraTarjetaElevada" BlurRadius="28" ShadowDepth="5" Direction="270"
                      Color="#2A3040" Opacity="0.19" />

</ResourceDictionary>
