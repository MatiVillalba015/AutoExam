<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Habilitado para System.Windows.Forms.Screen (US-003, fallback multi-monitor).
         System.Windows.Forms.dll ya se publica hoy, arrastrado transitivamente por
         AutoUpdater.NET.Official (su ventana de progreso es WinForms): no es una
         dependencia nueva, solo se habilita su uso directo en este proyecto. -->
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>

    <AssemblyName>AutoExam</AssemblyName>
    <RootNamespace>AutoExam</RootNamespace>
    <Product>AutoExam - Estudio UBA</Product>
    <Version>1.3.0</Version>
    <ApplicationIcon>imagexxcf_103507.ico</ApplicationIcon>

    <!-- Publicacion self-contained single-file -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <!-- El trimming queda desactivado: WPF no es compatible con IL trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoUpdater.NET.Official" Version="1.9.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Unico consumidor: Services/ConversorHeic.cs (decodifica HEIC/HEIF sin codec del SO,
         arquitectura Inc-4 §1.1, US-010/NFR-42). RID fijo win-x64, Q8 alcanza para foto->JPEG. -->
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.16.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- UseWindowsForms agrega "global using System.Windows.Forms;" y "global using
       System.Drawing;" implicitos que chocan con tipos de WPF que ya se usan sin
       calificar en todo el proyecto (Application, Brush, UserControl, DragEventArgs,
       IDataObject). Se sacan esos dos usings globales: el unico consumidor de WinForms
       (GeometriaVentanaService / MainWindow, US-003) ya califica System.Windows.Forms.Screen
       y System.Drawing.Rectangle explicitamente. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- US-040 / RN-51: las notas de version viajan adentro del ejecutable, no se bajan de
       internet. El archivo vive en la raiz del repo (asi se edita a mano y GitHub lo muestra
       renderizado) y se embebe desde aca, en vez de copiarse al lado del .exe: la app se
       publica como single-file self-contained, y un archivo suelto al lado del binario se
       pierde en cuanto alguien mueve el .exe solo. -->
  <ItemGroup>
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="AutoExam.CHANGELOG.md" />
  </ItemGroup>

</Project>
