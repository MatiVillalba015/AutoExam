<!--
    Sistema visual de AutoExam.

    Reglas que sostienen todo lo de abajo:
    · Un solo lugar define color, radio, sombra y tipografia. Ningun color literal
      vive en una vista.
    · Los pinceles toman el Color con DynamicResource, asi que cambiar de tema es
      intercambiar Tokens.Claro/Tokens.Oscuro sin recrear un solo estilo.
    · La familia mono se reserva para datos que se comparan de un vistazo
      (cronometro, nota, paginas). El texto que se lee corrido nunca es mono.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:comportamientos="clr-namespace:AutoExam.Behaviors">

    <!-- ==============================================================
         Tooltips (US-029).

         "Given un boton no tiene ya una descripcion visible de forma permanente,
         when paso el mouse por encima y lo mantengo, then aparece una breve
         descripcion de que hace ese boton DEBAJO de el."

         Va como estilo implicito (sin x:Key) y no como atributo repetido en cada
         boton: el lugar donde aparece el globo es una decision del sistema visual,
         no de cada vista, y asi ninguna pantalla puede quedarse afuera. Placement
         es propiedad del propio ToolTip, asi que una sola regla alcanza para toda
         la app; ToolTipService.Placement, en cambio, habria que ponerlo boton por
         boton.

         El retardo es el del sistema a proposito: el criterio dice "y lo mantengo".
         Un globo instantaneo aparece tambien cuando uno solo esta pasando el mouse
         camino a otra cosa.
         ============================================================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="HorizontalOffset" Value="0" />
        <Setter Property="VerticalOffset" Value="6" />
        <Setter Property="MaxWidth" Value="280" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="{DynamicResource PincelTarjeta}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadioCampo}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource SombraTarjeta}">
                        <!-- TextWrapping para que una descripcion de dos lineas no salga
                             como una tira de 600 px cruzando la pantalla. -->
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- ============================================================== -->
    <!-- Escalas. Los pinceles y la sombra viven en Theme/Tokens.*.xaml   -->
    <!-- ============================================================== -->
    <CornerRadius x:Key="RadioTarjeta">14</CornerRadius>
    <CornerRadius x:Key="RadioCampo">10</CornerRadius>
    <CornerRadius x:Key="RadioChip">18</CornerRadius>

    <!-- ==============================================================
         Tipografia (US-028 / RN-32).

         Cada familia es una CADENA de respaldo, no una fuente sola: WPF baja al
         siguiente nombre cuando el anterior no esta instalado. Por eso la app se ve
         igual de prolija en un Windows 11 (que trae Segoe UI Variable) que en un
         Windows 10 que solo tiene Segoe UI, sin ningun chequeo en codigo.

         "Inter" va primera aunque Windows no la traiga: si el usuario la instala
         alguna vez, la app la toma sola; si no, cae a la de siempre y no se nota.
         Nunca queda un hueco ni una fuente ajena: el ultimo eslabon de cada cadena
         es una familia que existe en todo Windows soportado.

         Los tamanios son la UNICA fuente de verdad de la escala: ninguna vista
         escribe un FontSize literal (RN-32). El de la pantalla de examen no esta
         aca sino en ExamenViewModel, porque el alumno lo ajusta en vivo (US-005);
         ahi tambien hay un solo lugar que lo define.
         ============================================================== -->
    <FontFamily x:Key="FuenteTitulo">Inter Display, Inter, Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteCuerpo">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteDato">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Escala afinada: los titulos bajan (30 era tamanio de portada, no de seccion) y
         el cuerpo sube medio punto. El contraste entre niveles se apoya mas en el peso
         y en el espaciado que en el salto de tamanio, que es lo que hacia que la
         pantalla se viera cargada. -->
    <sys:Double x:Key="TamTitulo">26</sys:Double>
    <sys:Double x:Key="TamSeccion">19</sys:Double>
    <sys:Double x:Key="TamEnunciado">16</sys:Double>
    <sys:Double x:Key="TamCuerpo">14</sys:Double>
    <sys:Double x:Key="TamMenor">12.5</sys:Double>
    <sys:Double x:Key="TamMinimo">11</sys:Double>

    <!-- ============================================================== -->
    <!-- Animacion. Duration/EasingFunction no son Freezables con estado -->
    <!-- propio (no se "gastan" al compartirlos), asi que una sola       -->
    <!-- instancia de cada uno alcanza para todos los templates de abajo.-->
    <!-- ============================================================== -->
    <Duration x:Key="DuracionHover">0:0:0.14</Duration>
    <Duration x:Key="DuracionPresion">0:0:0.13</Duration>
    <QuadraticEase x:Key="SuavizadoSalida" EasingMode="EaseOut" />
    <!-- Transicion de seccion del shell (US-007, Behaviors/TransicionContenido.cs). Mismo
         criterio de instancia unica que las dos de arriba. -->
    <Duration x:Key="DuracionTransicionSeccion">0:0:0.22</Duration>

    <!-- ============================================================== -->
    <!-- Tipografia                                                      -->
    <!-- ============================================================== -->
    <!-- Peso SemiBold y no Light: a 26px el Light se veia desvaido y sin jerarquia. Lo que
         separa un titulo de un parrafo grande ahora es el peso, no el tamanio, que es lo que
         permitio bajar la escala sin perder lectura. -->
    <Style x:Key="TxtTitulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteTitulo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamTitulo}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="TxtSeccion" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteTitulo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamSeccion}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TxtCuerpo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamCuerpo}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <!-- Contexto secundario. Color propio, no opacidad: la opacidad tambien
         apaga los bordes y los iconos que caen dentro del mismo contenedor. -->
    <Style x:Key="TxtSuave" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMenor}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoSuave}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TxtTenue" TargetType="TextBlock" BasedOn="{StaticResource TxtSuave}">
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoTenue}" />
    </Style>

    <!-- Rotulo de campo en versalitas: separa la etiqueta del dato sin usar negrita,
         que a este tamanio compite con el titulo de la seccion. -->
    <Style x:Key="TxtRotulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoTenue}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <!-- El rotulo se lee como etiqueta y no como texto. A este tamanio el espaciado
             entre letras hace ese trabajo mejor que subir el peso, que ya esta usado. -->
        <Setter Property="TextBlock.LineHeight" Value="15" />
    </Style>

    <!--
        Texto de ayuda debajo de un rotulo de seccion (US-030).

        Existe como estilo propio y no como un TxtTenue con margenes a mano porque el
        problema que resuelve es de ritmo, no de una pantalla puntual: la aclaracion de
        "Capitulos", la de "Materia" y la de "Eje tematico" venian cada una con su propio
        margen, y en dos de las tres quedaba pegada al rotulo de arriba. Al ser una sola
        regla, el espacio sobre el texto y el interlineado son los mismos en toda la app.

        LineStackingStrategy es necesario: sin el, LineHeight en WPF se interpreta como un
        minimo y el interlineado real lo sigue fijando la fuente, asi que el valor no
        tendria ningun efecto visible a este tamanio.
    -->
    <Style x:Key="TxtAyuda" TargetType="TextBlock" BasedOn="{StaticResource TxtTenue}">
        <Setter Property="Margin" Value="0,2,0,14" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="TxtDato" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteDato}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMenor}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoSuave}" />
    </Style>

    <!-- Texto que se puede arrastrar con el mouse para copiar. TextBox de solo
         lectura con template minimo: identico a un TextBlock a la vista. -->
    <Style x:Key="TextoSeleccionable" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamCuerpo}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Command="Copy" Header="Copiar" />
                    <MenuItem Command="SelectAll" Header="Seleccionar todo" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Tarjetas                                                        -->
    <!--                                                                 -->
    <!-- US-030 pide una jerarquia visual entre tres tipos de tarjeta:    -->
    <!-- la informativa (lo que hay), la seleccionable (lo que se elige)  -->
    <!-- y el resumen o bloque protagonista de la pantalla. La diferencia -->
    <!-- se lleva en la profundidad, no en el color: cambiar el fondo de  -->
    <!-- cada tipo obligaria a un tono distinto por tema y por estado, y  -->
    <!-- terminaria compitiendo con el color de materia (US-027) y con    -->
    <!-- los de correcto/incorrecto, que son los unicos que significan    -->
    <!-- algo. La sombra ordena sin decir nada.                           -->
    <!-- ============================================================== -->

    <!-- Nivel 2 de 3 — informativa. Es el default historico de la app y sigue      -->
    <!-- siendo el que usan las tarjetas que solo muestran algo.                    -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PincelTarjeta}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioTarjeta}" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Effect" Value="{DynamicResource SombraTarjeta}" />
    </Style>

    <!-- Nivel 1 de 3 — seleccionable. Va mas al ras que una informativa a proposito:
         lo que se elige tiene que verse disponible, no ya resuelto. Es la que usan las
         listas de items que se tildan (documentos, examenes del historial), donde ademas
         hay muchas juntas y apilar sombras profundas ensucia la pantalla entera. -->
    <Style x:Key="TarjetaSeleccionable" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="Effect" Value="{DynamicResource SombraTarjetaSuave}" />
    </Style>

    <!-- Nivel 3 de 3 — resumen / bloque protagonista. La usan el resumen de "vas a
         generar", la tarjeta del resultado y el enunciado de la pregunta en el examen:
         es lo unico que tiene que ganarle visualmente a todo lo demas de su pantalla.
         El borde de 2 px acompania a la sombra porque en tema oscuro la profundidad sola
         no alcanza para separar la tarjeta del fondo. -->
    <Style x:Key="TarjetaResumen" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="Effect" Value="{DynamicResource SombraTarjetaElevada}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
    </Style>

    <!-- Variante sin sombra para tarjetas anidadas: apilar sombras ensucia. -->
    <Style x:Key="TarjetaPlana" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource PincelSuperficie}" />
    </Style>

    <!-- ============================================================== -->
    <!-- Chips: la seleccion rapida que reemplaza a los campos de texto   -->
    <!-- ============================================================== -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMenor}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- 32 px de alto minimo: blanco de click comodo tambien con el trackpad. -->
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadioChip}"
                                SnapsToDevicePixels="True" />
                        <!-- Overlay de hover: nunca se anima el Brush de "Fondo" directo (rompería
                             el cambio de tema); se anima la Opacity de esta capa, pintada con el
                             mismo pincel que antes se asignaba instantáneo por Setter. -->
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioChip}" Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- RN-38: el contenido va DESPUES del overlay, no adentro del fondo.
                             PincelTarjetaHover es opaco, asi que con el contenido debajo la capa
                             de hover lo tapaba entero al llegar a Opacity 1. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <!-- Seleccionado: relleno + borde + texto de marca. El estado no
                             depende solo del color, tambien cambia el peso del texto. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                            <Setter Property="Foreground" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip que ejecuta una accion en vez de mantener estado (ej. "Marcar todos"). -->
    <Style x:Key="ChipAccion" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoSuave}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo" Background="Transparent"
                                BorderBrush="{DynamicResource PincelBorde}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadioChip}" />
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioChip}" Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- RN-38: el contenido va sobre el overlay opaco de hover, no debajo. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Opcion del examen: tarjeta clickeable con letra y texto copiable -->
    <!-- ============================================================== -->
    <Style x:Key="OpcionExamen" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo"
                                Background="{DynamicResource PincelTarjeta}"
                                BorderBrush="{DynamicResource PincelBorde}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadioCampo}" />
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioCampo}" Opacity="0"
                                IsHitTestVisible="False" />

                        <!--
                            US-030 — barra de acento de la opcion elegida.

                            El criterio pide que "seleccionado" se vea claramente distinto al
                            resto, "no un cambio sutil". El fondo tenue mas el borde de 2 px que
                            habia antes es exactamente eso: con cuatro tarjetas iguales apiladas
                            hay que comparar dos tonos parecidos entre si para saber cual esta
                            marcada. Una barra plena en el canto izquierdo se ve sin comparar
                            nada.

                            Va superpuesta en el Grid y no como una columna del contenido: asi
                            aparecer y desaparecer no corre el texto de la opcion ni un pixel.
                            Sale del color de marca y no de los de correcto/incorrecto porque
                            mientras se responde todavia no hay nada correcto que senalar.
                        -->
                        <Border x:Name="Acento" Width="5" HorizontalAlignment="Left" Opacity="0"
                                Background="{DynamicResource PincelMarca}" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource RadioCampo}" />

                        <!-- RN-38: el texto de la opcion se dibuja por encima del overlay de
                             hover. Estaba adentro de "Fondo", debajo de FondoHover, que usa un
                             pincel opaco: al pasar el mouse por una opcion, la opcion entera
                             quedaba en blanco. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                            <!-- El borde engorda a 2 px sin correr el texto: ahora el contenido es
                                 hermano del borde, no su hijo, asi que ya no hace falta compensar
                                 el grosor con un Padding mas chico. -->
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2" />
                            <!-- US-030: el acento es lo que hace que la opcion elegida se lea
                                 de un vistazo; el fondo y el borde solos no alcanzaban. -->
                            <Setter TargetName="Acento" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Zona de arrastre. Tambien es un boton: arrastrar nunca puede ser -->
    <!-- la unica forma de hacer algo (WCAG 2.2 - Dragging Movements).    -->
    <!-- ============================================================== -->
    <Style x:Key="ZonaSoltar" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo" Background="{DynamicResource PincelSuperficie}"
                                CornerRadius="{DynamicResource RadioTarjeta}" />
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelMarcaSuave}"
                                CornerRadius="{DynamicResource RadioTarjeta}" Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- El trazo discontinuo es la senial universal de "solta algo aca". -->
                        <Rectangle x:Name="Trazo" RadiusX="14" RadiusY="14"
                                   StrokeDashArray="5 4" StrokeThickness="1.5"
                                   Stroke="{DynamicResource PincelBordeFuerte}" />
                        <ContentPresenter Margin="24,28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Trazo" Property="Stroke" Value="{DynamicResource PincelMarca}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Trazo" Property="Stroke" Value="{DynamicResource PincelMarca}" />
                            <Setter TargetName="Trazo" Property="StrokeThickness" Value="2.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Navegacion lateral del shell                                    -->
    <!-- ============================================================== -->

    <!-- ==============================================================
         Tarjeta de acceso del menu principal (US-030 / US-031).

         El hover hace un zoom leve (1 -> 1.03) que agranda tambien el texto de
         adentro, mas 2 px de elevacion. El zoom vuelve despues de haberse sacado
         en la primera pasada de US-029: lo que molestaba entonces no era escalar
         sino que el escalado era un salto instantaneo. Interpolado con los mismos
         parametros que el resto, es lo que el criterio pide ahora explicitamente
         ("un zoom leve y su texto crece minimamente, de forma suave").

         Se escala el Grid entero y no cada texto por separado: una sola
         ScaleTransform sobre la raiz agranda icono, titulo y descripcion en la
         misma proporcion, y como es RenderTransform no toca el layout — la
         tarjeta crece sobre si misma sin correr a las otras tres.

         RN-38 — el contenido NUNCA depende del hover para verse: el
         ContentPresenter es el ULTIMO hijo del Grid, encima de la capa de realce.
         Antes vivia adentro de "Fondo", debajo de "Realce", y como
         PincelTarjetaHover es un pincel OPACO (#2C2741 en oscuro, #DFDDEB en
         claro), al llegar el hover a Opacity 1 la capa tapaba el contenido entero
         y la tarjeta se veia vacia. El mismo error estaba en otros cinco
         templates de este archivo y se corrigio igual en todos.

         Duracion, suavizado y la guarda de "reducir movimiento" son los mismos
         recursos centralizados que usan los otros templates (RN-33): aca no hay
         ningun sistema de animacion nuevo.
         ============================================================== -->
    <Style x:Key="TarjetaAcceso" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PincelTarjeta}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorde}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="MinHeight" Value="190" />
        <Setter Property="Padding" Value="24,26" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="Elevacion" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadioTarjeta}"
                                SnapsToDevicePixels="True" />

                        <!-- Se anima la Opacity de esta capa y no el Brush del fondo: animar un
                             Brush lo congela y rompe el cambio de tema claro/oscuro. -->
                        <Border x:Name="Realce" Background="{DynamicResource PincelTarjetaHover}"
                                BorderBrush="{DynamicResource PincelMarca}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadioTarjeta}" Opacity="0"
                                IsHitTestVisible="False" />

                        <!-- RN-38: ultimo hijo = siempre encima del realce. Ver el comentario
                             del estilo. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Realce" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Elevacion" Storyboard.TargetProperty="Y"
                                                         To="-2" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <!-- US-029: zoom leve. 1.03 sobre una tarjeta de 190 px son
                                             ~6 px de crecimiento y ~0,5 px de texto: se percibe como
                                             que la tarjeta se acerca, no como que el texto salta. -->
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX"
                                                         To="1.03" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY"
                                                         To="1.03" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Realce" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Elevacion" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- Con "reducir movimiento" el hover sigue existiendo, pero como un
                             cambio de estado directo: la tarjeta se resalta sin desplazarse ni
                             crecer. El zoom es justamente el tipo de movimiento que la
                             preferencia del sistema pide evitar. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Realce" Property="Opacity" Value="1" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Elevacion" Storyboard.TargetProperty="Y"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Elevacion" Storyboard.TargetProperty="Y"
                                                         To="-2" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================================
         Fila del resumen de actividad reciente del menu (US-031).

         Es un boton y no un Border con un gesto de click encima porque tiene que
         llegar por teclado y anunciarse como algo que se puede activar: es la unica
         forma de que "ultimo examen: 8/10" lleve al Historial sin mouse.

         Deliberadamente discreta: RN-37 dice que el resumen es de solo lectura y que
         a lo sumo navega. Si se viera como las cuatro tarjetas de accion, competiria
         con ellas por el primer click, que es justo lo contrario de lo que el menu
         tiene que lograr.

         Sin escala en el hover (US-029) y con la guarda de "reducir movimiento" en el
         pulsado (RN-33), igual que los otros templates.
         ============================================================== -->
    <Style x:Key="FilaDeActividad" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadioCampo}" />

                        <Border x:Name="Realce" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioCampo}" Opacity="0"
                                IsHitTestVisible="False" />

                        <!-- RN-38: el contenido va sobre el realce opaco, no debajo. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Realce" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Realce" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Realce" Property="Opacity" Value="1" />
                        </MultiTrigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Tarjeta de libro en la lista                                    -->
    <!-- ============================================================== -->
    <Style x:Key="ItemLibro" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- ListBoxItem no tiene IsPressed nativo (a diferencia de los ButtonBase de los
             otros 6 estilos de esta seccion); Presionable.cs lo suple con la misma
             semantica para poder usarlo en un MultiTrigger igual que los demas. -->
        <Setter Property="comportamientos:Presionable.Rastrear" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo" Background="{DynamicResource PincelTarjeta}"
                                BorderBrush="{DynamicResource PincelBorde}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadioCampo}"
                                Cursor="Hand" />
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioCampo}" Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- RN-38: la ficha del libro se dibuja sobre el realce, no debajo. -->
                        <ContentPresenter Margin="16,13" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- US-011 superficie 8 (RN-7): alta de items en Historial y Libros.
                             Fundido de entrada, solo Opacity (nunca Brush), duracion centralizada
                             (DuracionHover, el recurso compartido de esta seccion), no bloqueante.
                             Mismo patron que la entrada de Resultados en ExamenView.xaml: se dispara
                             cuando el contenedor pasa a visible Y "reducir movimiento" del SO esta
                             apagado (NFR-47/AC-T53) — con reducir-movimiento activo el item aparece
                             directo en Opacity=1, sin animar. La baja de items no se anima: WPF
                             descarta el contenedor antes de poder animarlo, y esa machinery
                             excede RN-7. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static comportamientos:Animaciones.Reducidas}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Raiz" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="comportamientos:Presionable.EstaPresionado" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Baldosa del navegador de preguntas (el elemento firma)          -->
    <!-- ============================================================== -->
    <Style x:Key="BaldosaPregunta" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource FuenteDato}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <!-- El numero se lee sobre los tres fondos semanticos, tambien el ambar. -->
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- El fondo real varia por pregunta (EstadoAPincel en ExamenView.xaml: sin
                         responder/correcta/incorrecta/salteada), asi que a diferencia de los
                         otros 6 estilos el hover no usa una capa overlay con un pincel fijo:
                         anima la Opacity del propio "Fondo" (1 -> 0.75), que funciona igual de
                         bien sobre cualquiera de esos colores y sigue sin tocar ningun Brush. -->
                    <Border x:Name="Fondo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fondo" Storyboard.TargetProperty="Opacity"
                                                         To="0.75" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fondo" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
