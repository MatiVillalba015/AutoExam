<UserControl x:Class="AutoExam.Views.ExamenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:modelos="clr-namespace:AutoExam.Models"
             xmlns:vm="clr-namespace:AutoExam.ViewModels"
             xmlns:comportamientos="clr-namespace:AutoExam.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ExamenViewModel}"
             comportamientos:AtajosDeExamen.Activos="True">

    <!--
        Atajos del examen. Van como InputBindings y no como manejadores de teclado:
        el gesto queda declarado al lado del comando que dispara.

        OJO: este UserControl NO puede ser Focusable. Con Focusable="True" el foco
        rebota del boton al UserControl durante el clic, ese cambio de foco libera
        la captura del mouse, y ButtonBase deja de convertir el MouseUp en Click:
        toda la pantalla del examen queda muerta al mouse sin un solo error.
        Los InputBindings igual funcionan, porque se buscan desde el elemento con
        foco hacia arriba y el foco queda en un descendiente de esta vista.
    -->
    <!--
        US-036 / RN-44 — los atajos ya no viven aca.

        Hasta ahora eran dieciseis KeyBinding escritos a mano en este archivo. RN-44 pide un
        mapeo centralizado, asi que las teclas se declaran en Models/AtajosExamen.cs y este
        comportamiento las aplica. Dos cosas mejoran con el cambio, ademas de la regla:
        la referencia que se le muestra al alumno se arma de la misma lista (no puede mentir),
        y los atajos dejan de dispararse cuando hay un campo de texto con foco — un KeyBinding
        se resuelve antes de que el control con foco vea la tecla, asi que desde ahi no habia
        forma de dejarla pasar.
    -->
    <Grid>

        <!-- ============================================================ -->
        <!-- Sin examen                                                    -->
        <!-- ============================================================ -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340"
                    Visibility="{Binding SinExamen, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" FontSize="32" HorizontalAlignment="Center"
                           Foreground="{DynamicResource PincelTextoTenue}" />
            <TextBlock Text="No hay ningun examen abierto" Style="{StaticResource TxtCuerpo}"
                       HorizontalAlignment="Center" Margin="0,16,0,4" />
            <TextBlock Style="{StaticResource TxtTenue}" TextAlignment="Center" Margin="0,0,0,20"
                       Text="Arma uno desde Nuevo examen: elegis el libro, el alcance y cuantas preguntas." />
            <ui:Button Content="Armar un examen" Appearance="Primary" ToolTip="Abre el asistente de Nuevo examen en el paso Material" HorizontalAlignment="Center"
                       Padding="20,10" Command="{Binding ArmarOtroCommand}" />
        </StackPanel>

        <!-- ============================================================ -->
        <!-- Rindiendo                                                     -->
        <!-- ============================================================ -->
        <Grid Visibility="{Binding Rindiendo, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Progreso: fijo, no scrollea con la pregunta (US-030). -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!--
                        US-027 — el color de la materia como acento del examen.

                        Es una pastilla y no un fondo de pantalla porque el criterio pide que
                        el color aparezca "sin reemplazar los colores de correcto/incorrecto":
                        tinendo superficies grandes, cualquier materia con un color calido
                        empieza a competir con el rojo de una respuesta errada. Concentrado en
                        una pastilla chica y en la barra de progreso, identifica la materia y
                        no se mete con lo que significa algo.
                    -->
                    <Border Padding="9,2" Margin="0,0,0,5" HorizontalAlignment="Left"
                            CornerRadius="{DynamicResource RadioChip}"
                            Background="{Binding ColorMateria, Converter={StaticResource ColorMateria},
                                         ConverterParameter=suave}"
                            Visibility="{Binding HayMateria, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Materia}" Style="{StaticResource TxtDato}" FontSize="11"
                                   Foreground="{Binding ColorMateria, Converter={StaticResource ColorMateria}}" />
                    </Border>

                    <TextBlock Text="{Binding Encabezado}" Style="{StaticResource TxtSeccion}" FontSize="18" />
                    <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource TxtTenue}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <!--
                        US-034 — el mismo lugar muestra dos cosas distintas: cuanto llevas
                        (modo de siempre) o cuanto te queda (modo cronometro). Se pinta de
                        error en los ultimos dos minutos, que es el aviso que pide el criterio.
                        Un dialogo a dos minutos del final robaria justamente el tiempo que
                        queda.
                    -->
                    <TextBlock Text="{Binding Cronometro}"
                               FontSize="19" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TxtDato}">
                                <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TiempoCritico}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PincelError}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding RotuloTiempo}" Style="{StaticResource TxtTenue}"
                               HorizontalAlignment="Right" FontSize="10"
                               Visibility="{Binding ConCronometro, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding Contadores}" Style="{StaticResource TxtTenue}"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <!-- Tamanio de texto de pregunta y opciones (US-005). Solo afecta esta vista. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <ui:Button Content="A-" Appearance="Transparent" Padding="10,8"
                               Command="{Binding DisminuirTextoExamenCommand}"
                               AutomationProperties.Name="Achicar el texto de la pregunta y las opciones"
                               ToolTip="Achicar texto" />
                    <ui:Button Content="A+" Appearance="Transparent" Padding="10,8" Margin="4,0,0,0"
                               Command="{Binding AumentarTextoExamenCommand}"
                               AutomationProperties.Name="Agrandar el texto de la pregunta y las opciones"
                               ToolTip="Agrandar texto" />
                </StackPanel>

                <ui:Button Grid.Column="3" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}"
                           Padding="8" VerticalAlignment="Center" Command="{Binding SalirCommand}"
                           AutomationProperties.Name="Salir del examen"
                           ToolTip="Salir del examen y descartar el intento" />
            </Grid>

            <!--
                Navegador de preguntas: cada baldosa ES una pregunta y se pinta con su
                estado. Convive con la barra de progreso de arriba porque dicen cosas
                distintas: la barra, cuanto falta de un vistazo; las baldosas, cual quedo
                salteada y a cual saltar.
            -->
            <!--
                Scroll vertical, nunca horizontal: un ScrollViewer que puede scrollear
                a lo ancho mide su contenido con ancho infinito, y entonces el WrapPanel
                nunca envuelve. Con 60 preguntas quedaba una tira de 2.100 px en una
                sola fila y la mitad de las baldosas fuera de la ventana.
            -->
            <!--
                US-030 — barra de progreso fija arriba.

                Va en su propia fila del Grid, fuera del ScrollViewer de la pregunta: asi al
                bajar por un enunciado largo se sigue viendo en que pregunta vas y cuanto
                falta. Antes "Pregunta 3 de 10" estaba adentro del area que scrollea y era lo
                primero que desaparecia justo cuando mas se necesita.

                La barra acompania al navegador de baldosas, no lo reemplaza: la barra dice
                cuanto falta de un vistazo, las baldosas dicen que quedo salteado.
            -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <!--
                    US-036 — referencia de atajos, solo la primera vez que se entra a un
                    examen. Discreta y descartable: una ayuda que reaparece siempre deja de
                    leerse y pasa a estorbar, asi que el "Entendido" se recuerda entre
                    reinicios (AppConfig.AtajosExamenVistos).

                    Las filas salen de AtajosExamen.Referencia, la misma lista de la que la
                    vista toma las teclas (RN-44): no puede quedar diciendo una tecla que ya
                    no hace nada.
                -->
                <Border Style="{StaticResource TarjetaSeleccionable}" Padding="16,12" Margin="0,0,0,12"
                        Visibility="{Binding MostrarAtajos, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="Keyboard24" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,14,0"
                                       Foreground="{DynamicResource PincelMarca}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Podés rendir con el teclado" Style="{StaticResource TxtCuerpo}"
                                       FontWeight="SemiBold" Margin="0,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Atajos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                            <Border Padding="7,2" Margin="0,0,7,0"
                                                    CornerRadius="{DynamicResource RadioChip}"
                                                    Background="{DynamicResource PincelMarcaSuave}">
                                                <TextBlock Text="{Binding Teclas}" Style="{StaticResource TxtDato}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PincelMarcaFuerte}" />
                                            </Border>
                                            <TextBlock Text="{Binding Que}" Style="{StaticResource TxtTenue}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Entendido" Style="{StaticResource ChipAccion}"
                                VerticalAlignment="Center" Margin="14,0,0,0"
                                ToolTip="No volver a mostrar los atajos al empezar un examen"
                                Command="{Binding OcultarAtajosCommand}" />
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{Binding ProgresoTexto}" Style="{StaticResource TxtTenue}" />
                    <TextBlock Style="{StaticResource TxtDato}" FontSize="11" HorizontalAlignment="Right"
                               Text="{Binding Examen.PorcentajeAvance, StringFormat='{}{0:0}% encarado'}" />
                </Grid>

                <!-- US-027: la barra tambien lleva el color de la materia. Es la superficie de
                     color mas grande que el criterio nombra explicitamente, y no puede
                     confundirse con nada: avanzar no es acertar. -->
                <ProgressBar Height="4" Minimum="0" Maximum="100"
                             Value="{Binding Examen.PorcentajeAvance, Mode=OneWay}"
                             Background="{DynamicResource PincelBorde}"
                             Foreground="{Binding ColorMateria, Converter={StaticResource ColorMateria}}"
                             BorderThickness="0"
                             AutomationProperties.Name="Avance del examen" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18" MaxHeight="112">
                <ItemsControl ItemsSource="{Binding Navegador}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type modelos:NavegadorItem}">
                            <Button Content="{Binding Numero}"
                                    AutomationProperties.Name="{Binding Accesible}"
                                    ToolTip="{Binding Accesible}"
                                    Command="{Binding DataContext.IrAPreguntaCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaldosaPregunta}">
                                        <Setter Property="Background"
                                                Value="{Binding Estado, Converter={StaticResource EstadoAPincel}}" />
                                        <Setter Property="BorderBrush"
                                                Value="{Binding Estado, Converter={StaticResource EstadoAPincel},
                                                        ConverterParameter=borde}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <!-- La pregunta en pantalla se marca con el color de
                                                 marca, no solo con un borde mas grueso: el grosor
                                                 solo no se distingue a este tamanio. -->
                                            <DataTrigger Binding="{Binding EsActual}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Pregunta -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                <StackPanel MaxWidth="860" HorizontalAlignment="Center">

                    <!--
                        US-030 — la pregunta y su imagen viven en una tarjeta propia, separada
                        de las opciones. Antes el enunciado, la figura y las cuatro opciones
                        eran un bloque continuo de texto sobre el mismo fondo, y en una
                        pregunta larga costaba ver donde terminaba el enunciado y donde
                        empezaba lo que hay que elegir.

                        Va en el nivel de profundidad mas alto (TarjetaResumen) y las opciones
                        en el mas bajo: el criterio pide que "la pregunta tenga mas peso visual
                        que las opciones". Antes las cuatro opciones eran tarjetas del mismo
                        tono que el enunciado, y la pantalla se leia como cinco bloques pares
                        en vez de una pregunta con sus respuestas.
                    -->
                    <Border Style="{StaticResource TarjetaResumen}" Margin="0,0,0,18" Padding="22,20">
                        <StackPanel>
                            <!--
                                US-005/US-028: el tamanio se ajusta solo aca (Rindiendo), no en
                                Theme/Estilos.xaml. TamanioTextoPregunta/Opciones son del
                                ExamenViewModel, calculadas a partir del nivel guardado en
                                AppConfig.TamanioTextoExamen.
                            -->
                            <TextBox Text="{Binding Actual.TextoPregunta, Mode=OneWay}"
                                     Style="{StaticResource TextoSeleccionable}"
                                     FontSize="{Binding TamanioTextoPregunta}" />

                            <Border Margin="0,18,0,0" Padding="12"
                                    Background="{DynamicResource PincelSuperficie}"
                                    BorderBrush="{DynamicResource PincelBorde}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadioCampo}"
                                    Visibility="{Binding Actual.TieneImagen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <!-- US-017: centrada dentro de la tarjeta. Una figura mas angosta que
                                         el tope quedaba contra el borde izquierdo con el resto del
                                         espacio en blanco a la derecha. -->
                                    <Image Source="{Binding Actual.RutaImagenAdjunta, Converter={StaticResource RutaAImagen}}"
                                           MaxHeight="320" MaxWidth="740" Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding PieImagen}" Style="{StaticResource TxtTenue}"
                                               Margin="2,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ELEGI UNA OPCION" Style="{StaticResource TxtRotulo}" />

                    <ItemsControl ItemsSource="{Binding Opciones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OpcionViewModel}">
                                <RadioButton Style="{StaticResource OpcionExamen}"
                                             IsChecked="{Binding Elegida, Mode=OneWay}"
                                             AutomationProperties.Name="{Binding Texto}"
                                             Command="{Binding DataContext.ResponderCommand,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- US-030: la letra tambien se pinta al elegir la
                                             opcion. Son dos senales de lo mismo (la barra de
                                             acento y la letra) porque la barra vive en el
                                             canto izquierdo y la letra donde ya esta mirando
                                             el ojo al leer la respuesta. -->
                                        <TextBlock Grid.Column="0" Text="{Binding Letra}"
                                                   FontFamily="{DynamicResource FuenteDato}"
                                                   FontWeight="Bold" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PincelTextoSuave}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Elegida}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PincelMarcaFuerte}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!--
                                            TextBlock y no TextBox: un TextBox marca el click
                                            como manejado para poner el cursor, y como ocupa
                                            casi toda la tarjeta, la opcion quedaba imposible
                                            de elegir con el mouse. Aca elegir gana a copiar.
                                        -->
                                        <TextBlock Grid.Column="1" Text="{Binding Texto}"
                                                   Style="{StaticResource TxtCuerpo}"
                                                   FontSize="{Binding DataContext.TamanioTextoOpciones,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Barra inferior -->
            <Grid Grid.Row="4" Margin="0,18,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowLeft24}"
                           Padding="10,8" Command="{Binding AnteriorCommand}"
                           AutomationProperties.Name="Pregunta anterior"
                           ToolTip="Anterior (flecha izquierda)" />

                <ui:Button Grid.Column="1" Content="Siguiente" Margin="8,0,0,0" Appearance="Primary"
                           MinWidth="140" Padding="16,8" Icon="{ui:SymbolIcon ArrowRight24}"
                           Command="{Binding SiguienteCommand}"
                           ToolTip="Siguiente (Enter o flecha derecha)" />

                <CheckBox Grid.Column="2" IsChecked="{Binding AvanceAutomatico, Mode=TwoWay}"
                          FontSize="11" VerticalAlignment="Center" Margin="20,0,0,0"
                          Foreground="{DynamicResource PincelTextoTenue}"
                          Content="Avanzar sola al responder"
                          ToolTip="Atajos: 1-4 o A-D eligen · Enter o flecha derecha avanza · flecha izquierda vuelve · S saltea" />

                <Button Grid.Column="3" Content="Saltear" Style="{StaticResource ChipAccion}"
                        Margin="0,0,10,0" VerticalAlignment="Center" Command="{Binding SaltearCommand}"
                        ToolTip="La pregunta queda Salteada y vuelve en el Modo Revancha (S)" />

                <ui:Button Grid.Column="4" Content="{Binding TextoFinalizar}" Padding="16,8" ToolTip="Termina el intento y lo corrige con la escala de la UBA"
                           Command="{Binding FinalizarCommand}" />
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- Resultados                                                    -->
        <!-- ============================================================ -->
        <!-- US-011 superficie 5 (RN-7): entrada de Resultados. Fundido + deslizamiento sutil,
             <= 250 ms, no bloqueante (solo Opacity/TranslateY, nunca Brush). Timing centralizado
             en Theme/Estilos.xaml. No dispara con "reducir movimiento" del SO (NFR-47). -->
        <Grid Visibility="{Binding EnResultados, Converter={StaticResource BoolToVis}}"
              RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding EnResultados}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static comportamientos:Animaciones.Reducidas}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="{StaticResource DuracionTransicionSeccion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="10" To="0"
                                                         Duration="{StaticResource DuracionTransicionSeccion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Mismo ancho que la lista de correccion: una sola columna de lectura.
                 US-030: es el resumen final de la pantalla, asi que va en el nivel de
                 profundidad mas alto, por encima de las tarjetas de cada pregunta. -->
            <Border Grid.Row="0" Style="{StaticResource TarjetaResumen}" Margin="0,0,0,22"
                    MaxWidth="920" HorizontalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- US-016, superficie nueva: el circulo de la nota entra con un "pop".
                         Es el momento en que el alumno ve el resultado; hasta ahora aparecia
                         junto con el resto de la tarjeta, sin nada propio. Decorativa y no
                         bloqueante: solo escala, no mueve el layout ni interrumpe la lectura.
                         Mismos parametros centralizados que US-011 y misma guarda de
                         "reducir movimiento" (RN-11). -->
                    <Border Grid.Column="0" Width="86" Height="86" CornerRadius="43" BorderThickness="3"
                            VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                            BorderBrush="{Binding Aprobado, Converter={StaticResource AprobadoAPincel}}"
                            Background="{Binding Aprobado, Converter={StaticResource AprobadoAPincel},
                                         ConverterParameter=suave}">
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding EnResultados}" Value="True" />
                                            <Condition Binding="{Binding Source={x:Static comportamientos:Animaciones.Reducidas}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                     From="0.86" To="1"
                                                                     Duration="{StaticResource DuracionTransicionSeccion}"
                                                                     EasingFunction="{StaticResource SuavizadoSalida}" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     From="0.86" To="1"
                                                                     Duration="{StaticResource DuracionTransicionSeccion}"
                                                                     EasingFunction="{StaticResource SuavizadoSalida}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Nota}" FontSize="34" FontWeight="Bold"
                                   FontFamily="{DynamicResource FuenteDato}"
                                   Foreground="{Binding Aprobado, Converter={StaticResource AprobadoAPincel}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="22,0,16,0" VerticalAlignment="Center">
                        <!-- US-013 / RN-5: literal fijo, tomado de la constante del ViewModel.
                             Visible solo con Nota >= 7 en el intento original. Sin opcion de ocultarlo.

                             US-015: el emoji es un elemento aparte y NO entra en la constante. El
                             literal de US-013 esta fijado por contrato, asi que se lo acompania
                             —que es lo que pide el criterio de US-015— en vez de modificarlo. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding MostrarFelicitacion, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#x1F389;" FontSize="16" Margin="0,0,7,0"
                                       VerticalAlignment="Top" />
                            <TextBlock Text="{x:Static vm:ExamenViewModel.MensajeFelicitacion}"
                                       Visibility="{Binding MostrarFelicitacion, Converter={StaticResource BoolToVis}}"
                                       FontWeight="Bold" FontSize="16" TextWrapping="Wrap"
                                       Foreground="{DynamicResource PincelAcierto}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Condicion}" Style="{StaticResource TxtSeccion}" FontSize="19" />
                        <TextBlock Text="{Binding ResumenResultado}" Style="{StaticResource TxtSuave}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding DetalleRondas}" Style="{StaticResource TxtTenue}"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <ui:Button Appearance="Primary" Margin="0,0,0,8" Padding="16,9"
                                   Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                                   Content="{Binding TextoRevancha}" Command="{Binding RevanchaCommand}"
                                   Visibility="{Binding HayPendientes, Converter={StaticResource BoolToVis}}" />
                        <!-- US-037: compartir el examen recien rendido. El archivo lleva las
                             preguntas y nada de este alumno: ni su nota ni que contesto (RN-45). -->
                        <Button Content="Compartir este examen" Style="{StaticResource ChipAccion}"
                                HorizontalAlignment="Center" Margin="0,0,0,8"
                                Command="{Binding ExportarCommand}"
                                ToolTip="Guarda un archivo para que otra persona rinda el mismo examen sin gastar su cuota de Gemini" />

                        <Button Content="Armar otro examen" Style="{StaticResource ChipAccion}" ToolTip="Vuelve al asistente para generar un examen nuevo"
                                HorizontalAlignment="Center" Command="{Binding ArmarOtroCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,14">
                <!-- La tarjeta de cada pregunta vive en App.xaml (TarjetaCorreccion): la
                     comparte con el detalle de un examen del historial (US-025), que tiene
                     que verse igual que esta pantalla. -->
                <ItemsControl ItemsSource="{Binding Correccion}" MaxWidth="920"
                              HorizontalAlignment="Center"
                              ItemTemplate="{StaticResource TarjetaCorreccion}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
