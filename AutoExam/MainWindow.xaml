<ui:FluentWindow x:Class="AutoExam.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:AutoExam.ViewModels"
                 xmlns:vistas="clr-namespace:AutoExam.Views"
                 xmlns:comportamientos="clr-namespace:AutoExam.Behaviors"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
                 Title="AutoExam"
                 Width="1240" Height="820"
                 MinWidth="980" MinHeight="660"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource PincelFondo}"
                 Loaded="Ventana_Loaded"
                 Closing="Ventana_Closing">

    <!--
        Navegacion por teclado entre secciones (US-004). Van a nivel Window, no en
        ExamenView.xaml: por estar en un scope distinto (Window vs. UserControl de
        Examen) y no compartir tecla con sus KeyBinding (1-4, NumPad1-4, A-D, flechas,
        Enter, S), no interfieren por construccion. Ctrl+1..5 = orden de Paginas
        (Libros, Nuevo examen, Examen, Historial, Ajustes). El no-disparo con foco en
        un campo de texto (NFR-10) lo resuelve ShellViewModel.PuedeIrA (CanExecute de
        IrACommand), no algo declarado aca.
    -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding IrACommand}" CommandParameter="libros" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding IrACommand}" CommandParameter="nuevo" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding IrACommand}" CommandParameter="examen" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding IrACommand}" CommandParameter="historial" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding IrACommand}" CommandParameter="ajustes" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AutoExam" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BookOpen24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============================================================ -->
        <!-- Cuerpo: barra de seccion + pagina activa                      -->
        <!--                                                               -->
        <!-- US-030: la barra lateral fija de 228 px se reemplazo por la    -->
        <!-- pantalla de inicio (InicioView) con una grilla de 4 tarjetas.  -->
        <!-- Sacar la columna no es solo estetico: el contenido de cada     -->
        <!-- seccion pasa a disponer del ancho completo, que es lo que le   -->
        <!-- da margen real al centrado de US-017 (RN-35).                  -->
        <!--                                                               -->
        <!-- Lo unico que queda fijo es una barra fina con el nombre de la  -->
        <!-- seccion abierta y el boton de volver al inicio, que aparece    -->
        <!-- solo cuando hay una seccion abierta. La navegacion por teclado -->
        <!-- (Ctrl+1..5) sigue funcionando igual, sin pasar por el inicio.  -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="26,4,26,10" Padding="0,0,0,10"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PincelBorde}"
                    Visibility="{Binding EnUnaSeccion, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" Padding="10,6"
                               Icon="{ui:SymbolIcon Home24}" Content="Inicio"
                               ToolTip="Volver a la pantalla de inicio"
                               AutomationProperties.Name="Volver a la pantalla de inicio"
                               Command="{Binding IrAInicioCommand}" />

                    <TextBlock Text="/" Style="{StaticResource TxtTenue}" Margin="12,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding TituloSeccion}" Style="{StaticResource TxtCuerpo}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Pagina activa: WPF elige la vista por el tipo del ViewModel (los
                 DataTemplate viven en App.xaml). El inicio entra por el mismo
                 ContentControl que las demas, asi que la transicion suave entre
                 pantallas (US-029) cubre tambien ir y volver del inicio. -->
            <ContentControl Grid.Row="1" Content="{Binding Pagina}" Margin="26,0,26,0"
                            Focusable="False" comportamientos:TransicionContenido.Activa="True" />
        </Grid>

        <!-- ============================================================ -->
        <!-- Barra de estado                                               -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Padding="26,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource PincelBorde}">
            <Grid>
                <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource TxtTenue}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding EstadoApi}" Style="{StaticResource TxtDato}"
                               FontSize="11" VerticalAlignment="Center" />

                    <TextBlock Text="·" Style="{StaticResource TxtDato}" FontSize="11"
                               Margin="8,0" VerticalAlignment="Center" />

                    <!-- Version instalada: es lo que hay que mirar para saber si una
                         actualizacion realmente se aplico. -->
                    <TextBlock Text="{Binding Version}" Style="{StaticResource TxtDato}"
                               FontSize="11" VerticalAlignment="Center"
                               ToolTip="Version instalada de AutoExam" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Pantalla de inicio: configurar y verificar antes de entrar     -->
        <!-- ============================================================ -->
        <vistas:OnboardingView Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="10"
                               DataContext="{Binding Onboarding}"
                               Visibility="{Binding DataContext.MostrarBienvenida,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource BoolToVis}}" />
    </Grid>
</ui:FluentWindow>
