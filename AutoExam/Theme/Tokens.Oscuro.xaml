<!--
    Paleta oscura. Pensada para leer enunciados largos de noche: el fondo es
    tinta azulada (no negro puro) y el texto no llega al blanco, que es lo que
    produce el halo y el cansancio en sesiones largas.

    El violeta de marca existe por una razon concreta: verde, rojo y ambar ya
    estan tomados por la correccion (correcta / incorrecta / salteada). Un acento
    en esos tonos competiria con el significado de la nota.

    Los pinceles se definen aca con su color literal, y no en Estilos.xaml a
    partir de tokens de Color: un pincel guardado en un diccionario no esta en el
    arbol visual, asi que un DynamicResource adentro suyo no se vuelve a resolver
    al cambiar de tema y la app se queda con la paleta vieja.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Superficies: gris con temperatura violeta sutil (mismo matiz que PincelMarca), para
         que el morado predomine tambien fuera de los acentos -->
    <SolidColorBrush x:Key="PincelFondo" Color="#16141F" />
    <SolidColorBrush x:Key="PincelSuperficie" Color="#1E1C2C" />
    <SolidColorBrush x:Key="PincelTarjeta" Color="#252237" />
    <SolidColorBrush x:Key="PincelTarjetaHover" Color="#2C2741" />
    <SolidColorBrush x:Key="PincelBorde" Color="#35314C" />
    <SolidColorBrush x:Key="PincelBordeFuerte" Color="#433E5D" />

    <!-- Texto -->
    <SolidColorBrush x:Key="PincelTexto" Color="#E4E7EE" />
    <SolidColorBrush x:Key="PincelTextoSuave" Color="#A2AAB9" />
    <SolidColorBrush x:Key="PincelTextoTenue" Color="#7C8595" />

    <!-- Marca -->
    <SolidColorBrush x:Key="PincelMarca" Color="#9B87F5" />
    <SolidColorBrush x:Key="PincelMarcaFuerte" Color="#B3A3FF" />
    <SolidColorBrush x:Key="PincelMarcaSuave" Color="#2A2440" />
    <SolidColorBrush x:Key="PincelSobreMarca" Color="#12101C" />

    <!-- Semantica de correccion: fija, nunca se reutiliza para decorar. Mismo matiz que antes
         (verde/rojo/ambar, nunca corrido hacia el violeta) — solo se ajusto luminancia/
         saturacion para que Acierto/Error/Pendiente se distingan entre si (NFR-33/AC-T39).
         Aca Pendiente pasa a ser el mas oscuro de los tres (en vez del mas claro, como en el
         tema claro) y por eso PincelPendienteSuave se aclaro (dejo de ser un tinte casi negro):
         contra un "Suave" casi negro, un Pendiente igual de oscuro no llegaba a 3:1. -->
    <SolidColorBrush x:Key="PincelAcierto" Color="#00FE7F" />
    <SolidColorBrush x:Key="PincelAciertoSuave" Color="#16281F" />
    <SolidColorBrush x:Key="PincelError" Color="#F60005" />
    <SolidColorBrush x:Key="PincelErrorSuave" Color="#2B191B" />
    <SolidColorBrush x:Key="PincelPendiente" Color="#3E2C02" />
    <SolidColorBrush x:Key="PincelPendienteSuave" Color="#A87A31" />

    <!--
        Tres niveles de profundidad (US-030), como en el tema claro pero mas marcados: sobre
        fondo oscuro una sombra tenue directamente no se ve, asi que el escalon entre niveles
        tiene que ser mayor para que la misma jerarquia se lea igual en los dos temas.
    -->
    <DropShadowEffect x:Key="SombraTarjetaSuave" BlurRadius="14" ShadowDepth="2" Direction="270"
                      Color="#000000" Opacity="0.38" />

    <DropShadowEffect x:Key="SombraTarjeta" BlurRadius="22" ShadowDepth="3" Direction="270"
                      Color="#000000" Opacity="0.55" />

    <DropShadowEffect x:Key="SombraTarjetaElevada" BlurRadius="34" ShadowDepth="6" Direction="270"
                      Color="#000000" Opacity="0.7" />

</ResourceDictionary>
