                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Opcion del examen: tarjeta clickeable con letra y texto copiable -->
    <!-- ============================================================== -->
    <!-- US-057: mas aire entre opciones y esquinas mas suaves. Cuatro tarjetas separadas por
         10 px con esquinas de 10 se leian como un bloque de cuatro renglones; con 14 y 14 se
         leen como cuatro cosas que se eligen. El padding tambien crece: es la superficie que
         se toca, y en una pantalla donde se responde con el mouse conviene que sobre. -->
    <Style x:Key="OpcionExamen" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo"
                                Background="{DynamicResource PincelTarjeta}"
                                BorderBrush="{DynamicResource PincelBorde}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadioTarjeta}" />
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioTarjeta}" Opacity="0"
                                IsHitTestVisible="False" />

                        <!--
                            US-030 — barra de acento de la opcion elegida.

                            El criterio pide que "seleccionado" se vea claramente distinto al
                            resto, "no un cambio sutil". El fondo tenue mas el borde de 2 px que
                            habia antes es exactamente eso: con cuatro tarjetas iguales apiladas
                            hay que comparar dos tonos parecidos entre si para saber cual esta
                            marcada. Una barra plena en el canto izquierdo se ve sin comparar
                            nada.

                            Va superpuesta en el Grid y no como una columna del contenido: asi
                            aparecer y desaparecer no corre el texto de la opcion ni un pixel.
                            Sale del color de marca y no de los de correcto/incorrecto porque
                            mientras se responde todavia no hay nada correcto que senalar.
                        -->
                        <!-- US-057 la adelgaza de 5 a 3 px. La barra se queda —es lo que hace
                             que la elegida se lea sin comparar tonos, que es lo que pide
                             US-030— pero deja de ser un bloque: a 3 px es un canto, y con el
                             relleno tenue y el borde fino de abajo alcanza de sobra. -->
                        <Border x:Name="Acento" Width="3" HorizontalAlignment="Left" Opacity="0"
                                Background="{DynamicResource PincelMarca}" IsHitTestVisible="False"
                                CornerRadius="{DynamicResource RadioTarjeta}" />

                        <!-- RN-38: el texto de la opcion se dibuja por encima del overlay de
                             hover. Estaba adentro de "Fondo", debajo de FondoHover, que usa un
                             pincel opaco: al pasar el mouse por una opcion, la opcion entera
                             quedaba en blanco. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <!-- US-057 — la opcion elegida, sin marco grueso.
                             El borde vuelve a 1 px y baja de PincelMarcaFuerte al violeta de
                             marca: lo que marcaba la eleccion era un marco de 2 px en el tono
                             mas luminoso de la paleta, y sobre cuatro tarjetas apiladas eso es
                             lo que hacia ruido. Queda un relleno apenas insinuado, un borde
                             fino y el canto de acento, que juntos se leen igual de rapido y
                             pesan mucho menos. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="1" />
                            <!-- US-030: el acento es lo que hace que la opcion elegida se lea
                                 de un vistazo; el fondo y el borde solos no alcanzaban. -->
                            <Setter TargetName="Acento" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Zona de arrastre. Tambien es un boton: arrastrar nunca puede ser -->
    <!-- la unica forma de hacer algo (WCAG 2.2 - Dragging Movements).    -->
    <!-- ============================================================== -->
    <Style x:Key="ZonaSoltar" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo" Background="{DynamicResource PincelSuperficie}"
                                CornerRadius="{DynamicResource RadioTarjeta}" />
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelMarcaSuave}"
                                CornerRadius="{DynamicResource RadioTarjeta}" Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- El trazo discontinuo es la senial universal de "solta algo aca". -->
                        <Rectangle x:Name="Trazo" RadiusX="14" RadiusY="14"
                                   StrokeDashArray="5 4" StrokeThickness="1.5"
                                   Stroke="{DynamicResource PincelBordeFuerte}" />
                        <ContentPresenter Margin="24,28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Trazo" Property="Stroke" Value="{DynamicResource PincelMarca}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Trazo" Property="Stroke" Value="{DynamicResource PincelMarca}" />
                            <Setter TargetName="Trazo" Property="StrokeThickness" Value="2.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Navegacion lateral del shell                                    -->
    <!-- ============================================================== -->

    <!-- ==============================================================
         Tarjeta de acceso del menu principal (US-030 / US-031).

         El hover hace un zoom leve (1 -> 1.03) que agranda tambien el texto de
         adentro, mas 2 px de elevacion. El zoom vuelve despues de haberse sacado
         en la primera pasada de US-029: lo que molestaba entonces no era escalar
         sino que el escalado era un salto instantaneo. Interpolado con los mismos
         parametros que el resto, es lo que el criterio pide ahora explicitamente
         ("un zoom leve y su texto crece minimamente, de forma suave").

         Se escala el Grid entero y no cada texto por separado: una sola
         ScaleTransform sobre la raiz agranda icono, titulo y descripcion en la
         misma proporcion, y como es RenderTransform no toca el layout — la
         tarjeta crece sobre si misma sin correr a las otras tres.

         RN-38 — el contenido NUNCA depende del hover para verse: el
         ContentPresenter es el ULTIMO hijo del Grid, encima de la capa de realce.
         Antes vivia adentro de "Fondo", debajo de "Realce", y como
         PincelTarjetaHover es un pincel OPACO (#2C2741 en oscuro, #DFDDEB en
         claro), al llegar el hover a Opacity 1 la capa tapaba el contenido entero
         y la tarjeta se veia vacia. El mismo error estaba en otros cinco
         templates de este archivo y se corrigio igual en todos.

         Duracion, suavizado y la guarda de "reducir movimiento" son los mismos
         recursos centralizados que usan los otros templates (RN-33): aca no hay
         ningun sistema de animacion nuevo.
         ============================================================== -->
    <Style x:Key="TarjetaAcceso" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PincelTarjeta}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorde}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- US-041: la tarjeta sigue en la grilla 2x2 de US-030, pero adentro dejo de ser un
             bloque cuadrado (icono grande arriba, texto abajo) para volverse una fila: cuadrado
             de icono a la izquierda, titulo y descripcion a la derecha. Con el texto al costado
             y no debajo del icono, el alto minimo baja de 190 a 106.

             El margen solo empuja hacia la derecha y hacia abajo; la vista cancela el sobrante
             del borde exterior con un margen negativo, para que la grilla quede alineada con lo
             que tiene al lado. -->
        <Setter Property="Margin" Value="0,0,14,14" />
        <Setter Property="MinHeight" Value="106" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="Elevacion" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadioTarjeta}"
                                SnapsToDevicePixels="True" />

                        <!-- Se anima la Opacity de esta capa y no el Brush del fondo: animar un
                             Brush lo congela y rompe el cambio de tema claro/oscuro. -->
                        <Border x:Name="Realce" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioTarjeta}" Opacity="0"
                                IsHitTestVisible="False" />

                        <!-- US-041 — el anillo violeta del hover, en su propia capa y no como
                             borde del realce. Separarlo es lo que permite que el borde se vea
                             completo: el realce se dibuja detras del contenido y su borde
                             quedaba tapado por la tarjeta en los bordes redondeados. Ademas,
                             2 px de anillo sobre el borde de 1 px del fondo se leen como un
                             marco que aparece, no como el borde de siempre cambiando de color. -->
                        <Border x:Name="AnilloHover" BorderBrush="{DynamicResource PincelMarca}"
                                BorderThickness="2" CornerRadius="{DynamicResource RadioTarjeta}"
                                Opacity="0" IsHitTestVisible="False" />

                        <!-- RN-38: ultimo hijo = siempre encima del realce. Ver el comentario
                             del estilo.

                             US-041: se estira a lo ancho en vez de centrarse. Con la tarjeta
                             horizontal, el contenido es una fila (icono + textos + insignia) que
                             tiene que ocupar todo el ancho; centrado, quedaba un bloque angosto
                             flotando en el medio de una tarjeta ancha. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Realce" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <!-- US-041: el anillo violeta entra con el mismo tiempo y
                                             el mismo suavizado que el resto del hover, asi las tres
                                             cosas (realce, anillo y zoom) se leen como un solo
                                             movimiento y no como tres efectos encimados. -->
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Elevacion" Storyboard.TargetProperty="Y"
                                                         To="-2" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <!-- US-029 / US-041: zoom leve. 1.03 sobre una tarjeta de la
                                             grilla son ~13 px de crecimiento y menos de medio pixel
                                             de texto: se percibe como que la tarjeta se acerca, no
                                             como que el texto salta. -->
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX"
                                                         To="1.03" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY"
                                                         To="1.03" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Realce" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Elevacion" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- Con "reducir movimiento" el hover sigue existiendo, pero como un
                             cambio de estado directo: la tarjeta se resalta sin desplazarse ni
                             crecer. El zoom es justamente el tipo de movimiento que la
                             preferencia del sistema pide evitar. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Realce" Property="Opacity" Value="1" />
                            <!-- El anillo si aparece con movimiento reducido: es un cambio de
                                 color, no un movimiento, y es lo que deja claro cual de las
                                 cuatro tarjetas esta debajo del cursor. -->
                            <Setter TargetName="AnilloHover" Property="Opacity" Value="1" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Elevacion" Storyboard.TargetProperty="Y"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Elevacion" Storyboard.TargetProperty="Y"
                                                         To="-2" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- ==============================================================
             La tarjeta destacada del menu: "Generar examen" (US-041).

             El disparador vive aca dentro y no en un estilo aparte a proposito. Un estilo
             derivado obligaria a la vista a elegir cual de los dos aplicar, y en XAML esa
             eleccion condicional se escribe como un <Style> anonimo dentro del Button, que
             es justo lo que hace que la tarjeta deje de declarar "uso TarjetaAcceso". Con
             el disparador aca, las cuatro tarjetas usan literalmente el mismo estilo y la
             que viene marcada como principal cambia sola.

             Solo cambian fondo y borde: hereda el template entero —el mismo hover, el
             mismo zoom, la misma guarda de "reducir movimiento"—, asi la accion mas usada
             se lee como la principal sin comportarse distinto de las otras tres.

             Los dos pinceles son los de marca que ya existen (US-027), no colores nuevos:
             en tema oscuro PincelMarcaSuave es un violeta apagado sobre el que el texto
             blanco sigue leyendose, y en tema claro es un lavanda palido con el mismo
             contraste.
             ============================================================== -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding EsPrincipal}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==============================================================
         Cuadrado del icono de una tarjeta del menu (US-041).

         Un solo lugar define su tamanio, su radio y su degradado, para que las cuatro
         tarjetas no se vayan separando a medida que se toca una.
         ============================================================== -->
    <Style x:Key="CuadroDeIcono" TargetType="Border">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PincelIconoAccion}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ==============================================================
         Fila del resumen de actividad reciente del menu (US-031).

         Es un boton y no un Border con un gesto de click encima porque tiene que
         llegar por teclado y anunciarse como algo que se puede activar: es la unica
         forma de que "ultimo examen: 8/10" lleve al Historial sin mouse.

         Deliberadamente discreta: RN-37 dice que el resumen es de solo lectura y que
         a lo sumo navega. Si se viera como las cuatro tarjetas de accion, competiria
         con ellas por el primer click, que es justo lo contrario de lo que el menu
         tiene que lograr.

         Desde US-041 el hover si escala, como el de las tarjetas, porque el criterio lo
         pide para los dos: la ficha crece 1.02 (menos que el 1.03 de la tarjeta, que es
         mucho mas grande) y se le enciende el mismo anillo violeta. Sigue siendo mas
         discreta que una tarjeta de accion —no se eleva ni proyecta sombra—, que es lo
         que RN-37 protege. Con la guarda de "reducir movimiento" en todos los casos (RN-33),
         igual que los otros templates.
         ============================================================== -->
    <Style x:Key="FilaDeActividad" TargetType="Button">
        <!-- US-041: la fila pasa de transparente a tener superficie propia. En el mockup cada
             examen es una ficha con su barra de acento, no un renglon suelto: sin fondo, la
             barra vertical de la izquierda queda flotando contra el panel y no se lee como el
             borde de nada. -->
        <Setter Property="Background" Value="{DynamicResource PincelTarjeta}" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Sin relleno a la izquierda ni arriba y abajo: la barra de acento va pegada al
             borde de la ficha y la cruza entera, como en el mockup. El aire lo pone el
             contenido, que es el unico que sabe cual de sus columnas tiene que respirar. -->
        <Setter Property="Padding" Value="0,0,14,0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="Fondo" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadioCampo}" />

                        <Border x:Name="Realce" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioCampo}" Opacity="0"
                                IsHitTestVisible="False" />

                        <!-- RN-38: el contenido va sobre el realce opaco, no debajo. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}" />

                        <!-- US-041 — el mismo anillo violeta que la tarjeta de accion, con el
                             radio de la ficha. Es la senial de "esto se puede tocar" en las dos
                             mitades del menu, asi que tiene que ser la misma.

                             Va DESPUES del contenido, al reves que el realce: la barra de acento
                             de la materia esta pegada al borde izquierdo y es opaca, asi que
                             dibujada encima le comia el lado izquierdo al anillo y el marco
                             quedaba abierto. No contradice RN-38 porque esta capa no tiene
                             fondo: es un borde con el centro transparente, no tapa nada. -->
                        <Border x:Name="AnilloHover" BorderBrush="{DynamicResource PincelMarca}"
                                BorderThickness="2" CornerRadius="{DynamicResource RadioCampo}"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Realce" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <!-- 1.02 y no 1.03: la ficha es la mitad de alta que una
                                             tarjeta, y con el mismo factor el crecimiento se nota
                                             de mas contra las dos fichas quietas de al lado. -->
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX"
                                                         To="1.02" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY"
                                                         To="1.02" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Realce" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Realce" Property="Opacity" Value="1" />
                            <Setter TargetName="AnilloHover" Property="Opacity" Value="1" />
                        </MultiTrigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Tarjeta de libro en la lista                                    -->
    <!-- ============================================================== -->
    <Style x:Key="ItemLibro" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- ListBoxItem no tiene IsPressed nativo (a diferencia de los ButtonBase de los
             otros 6 estilos de esta seccion); Presionable.cs lo suple con la misma
             semantica para poder usarlo en un MultiTrigger igual que los demas. -->
        <Setter Property="comportamientos:Presionable.Rastrear" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <!-- US-043: mismo degradado minimo que las demas tarjetas que se
                             eligen. La lista de documentos a combinar es justamente una de
                             las que el criterio nombra. -->
                        <Border x:Name="Fondo" Background="{DynamicResource PincelTarjetaProfunda}"
                                BorderBrush="{DynamicResource PincelBorde}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadioCampo}"
                                Cursor="Hand" />
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioCampo}" Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- RN-38: la ficha del libro se dibuja sobre el realce, no debajo. -->
                        <ContentPresenter Margin="16,13" />

                        <!-- US-045 / RN-53: el mismo anillo de acento que las tarjetas del menu
                             y las del asistente. Desde esta historia el hover con anillo es el
                             estandar de la app, asi que la ficha de un libro y la de un examen
                             responden igual al mouse. Va despues del contenido para que el
                             marco se cierre entero. -->
                        <Border x:Name="AnilloHover" BorderBrush="{DynamicResource PincelMarca}"
                                BorderThickness="2" CornerRadius="{DynamicResource RadioCampo}"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- US-011 superficie 8 (RN-7): alta de items en Historial y Libros.
                             Fundido de entrada, solo Opacity (nunca Brush), duracion centralizada
                             (DuracionHover, el recurso compartido de esta seccion), no bloqueante.
                             Mismo patron que la entrada de Resultados en ExamenView.xaml: se dispara
                             cuando el contenedor pasa a visible Y "reducir movimiento" del SO esta
                             apagado (NFR-47/AC-T53) — con reducir-movimiento activo el item aparece
                             directo en Opacity=1, sin animar. La baja de items no se anima: WPF
                             descarta el contenedor antes de poder animarlo, y esa machinery
                             excede RN-7. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static comportamientos:Animaciones.Reducidas}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Raiz" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <!-- US-045 / RN-53: anillo de acento y zoom leve, como en el
                                             resto de la app. 1.01 y no 1.02: la ficha de un libro es
                                             mucho mas ancha que alta, y ahi el mismo factor se nota de
                                             mas contra las fichas quietas de arriba y de abajo. -->
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1.01" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1.01" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="comportamientos:Presionable.EstaPresionado" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Baldosa del navegador de preguntas (el elemento firma)          -->
    <!-- ============================================================== -->
    <Style x:Key="BaldosaPregunta" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource FuenteDato}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <!-- El numero se lee sobre los tres fondos semanticos, tambien el ambar. -->
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- El fondo real varia por pregunta (EstadoAPincel en ExamenView.xaml: sin
                         responder/correcta/incorrecta/salteada), asi que a diferencia de los
                         otros 6 estilos el hover no usa una capa overlay con un pincel fijo:
                         anima la Opacity del propio "Fondo" (1 -> 0.75), que funciona igual de
                         bien sobre cualquiera de esos colores y sigue sin tocar ningun Brush. -->
                    <Border x:Name="Fondo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fondo" Storyboard.TargetProperty="Opacity"
                                                         To="0.75" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fondo" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================================
         US-044 — pastillas de dato del Historial.

         Correctas, incorrectas y salteadas dejan de ser una linea de texto corrido y pasan a
         tres fichas de color. El dato es exactamente el mismo; lo que cambia es que ahora se
         reconoce por el color antes de leerlo, que es lo que uno hace al barrer una lista de
         veinte examenes buscando el que le fue mal.

         Los colores son los de correccion que ya existen (US-027) y no unos nuevos: verde es
         acierto y rojo es error en toda la app, y aca significan lo mismo. El color NUNCA va
         solo — cada pastilla dice tambien "correctas" / "incorrectas" / "salteadas" —, que es
         lo que la hace legible para alguien que no distingue verde de rojo.
         ============================================================== -->
    <Style x:Key="Pastilla" TargetType="Border">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioChip}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PincelSuperficie}" />
    </Style>

    <Style x:Key="TextoDePastilla" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoSuave}" />
    </Style>

    <!-- ==============================================================
         US-044 — boton de icono con tinte de hover.

         El criterio pide que al pasar el mouse aparezca "un coloreado suave de fondo del color
         que corresponda a esa accion, con una transicion gradual". El tinte concreto lo pone
         cada uso via Background del propio boton, que en reposo esta en Opacity 0: asi el
         mismo estilo sirve para el icono de ver el detalle (violeta) y el de borrar (rojo) sin
         duplicar el template.

         Se anima la Opacity de la capa y no su Brush, como en todo el resto del archivo:
         animar un Brush lo congela y rompe el cambio de tema claro/oscuro.
         ============================================================== -->
    <Style x:Key="IconoDeAccion" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorde}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoSuave}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fondo" Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadioCampo}" />

                        <Border x:Name="Tinte" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadioCampo}" Opacity="0"
                                IsHitTestVisible="False" />

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tinte" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tinte" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================================
         US-044 — contenedor de un examen en la lista del Historial.

         A diferencia de ItemLibro, este NO dibuja tarjeta: la dibuja el propio item, porque su
         franja de materia tiene que ir pegada al borde y el relleno de ItemLibro la dejaba
         flotando adentro. Aca el contenedor solo aporta el espacio entre tarjetas.

         Sigue siendo un ListBoxItem y no un ItemsControl suelto para no perder lo que el
         contenedor da gratis: llegar por teclado a cada examen y anunciarse como una lista.
         ============================================================== -->
    <Style x:Key="ItemDeHistorial" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================================
         US-044 — encabezado de un panel que se despliega.

         Es un ToggleButton pelado: la fila entera es el area de click, sin fondo ni borde
         propios, porque el panel que abre ya vive adentro de una tarjeta. El estado (abierto /
         cerrado) lo lleva el propio boton, y el panel de abajo se engancha a su IsChecked para
         animar su altura — que es lo que un CardExpander no deja hacer sin reescribirle el
         template entero.
         ============================================================== -->
    <Style x:Key="EncabezadoDesplegable" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================================
         US-044 — la accion destructiva: borrar TODO el historial.

         Se distingue por el color y no por el tamanio ni por la posicion: en rojo desde el
         reposo (borde y texto) y con el tinte rojo al pasar el mouse, para que nadie la
         confunda con las otras acciones de la pantalla. No pierde la confirmacion explicita:
         RN-6 sigue valiendo y el comando la pide antes de borrar nada — el color avisa, no
         reemplaza al "estas seguro".

         Es tambien el unico punto de borrado total desde que se saco la seccion "Escala UBA y
         datos guardados", donde el mismo boton vivia escondido adentro de un desplegable.
         ============================================================== -->
    <Style x:Key="BotonDestructivo" TargetType="Button" BasedOn="{StaticResource IconoDeAccion}">
        <Setter Property="Background" Value="{DynamicResource PincelErrorSuave}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelError}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelError}" />
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamCuerpo}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ==============================================================
         US-043 — las tarjetas de "de donde salen las preguntas".

         Son las cuatro opciones grandes del paso Material. Hasta ahora usaban el estilo Chip,
         el mismo de las fichas chicas ("Libro completo", "20 min", el nombre de una materia).
         Comparten la logica —un grupo de opciones excluyentes— pero no el peso: estas cuatro
         son la primera decision del asistente y ocupan media pantalla, mientras que una ficha
         es una palabra. Por eso tienen estilo propio en vez de engordar Chip: tocar Chip para
         estas cuatro le hubiera puesto zoom y anillo a las treinta fichas chicas de la app.

         Las dos escalas van separadas y no en un solo ScaleTransform: el hover lleva Zoom a
         1.02 y ahi se queda mientras el mouse este encima, y el pulsado mueve Presion, que
         vuelve sola a 1 al soltar. Con una sola escala compartida, soltar el click devolvia
         la tarjeta a 1.0 —tamanio de reposo— aunque el mouse siguiera encima, y el hover se
         perdia hasta salir y volver a entrar. Multiplicadas dan 1.02 en hover y ~1.00
         mientras se aprieta: el "hundimiento" que pide el criterio es exactamente esa
         diferencia.
         ============================================================== -->
    <Style x:Key="TarjetaDeOpcion" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                                <ScaleTransform x:Name="Presion" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Border x:Name="Fondo"
                                Background="{DynamicResource PincelTarjetaProfunda}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadioCampo}"
                                SnapsToDevicePixels="True" />

                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioCampo}" Opacity="0"
                                IsHitTestVisible="False" />

                        <!-- RN-38: el contenido va DESPUES del realce opaco, no adentro del
                             fondo, o al llegar el hover a Opacity 1 la tarjeta se ve vacia. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />

                        <!-- El anillo de acento va sobre el contenido, como en el menu (US-041):
                             asi se cierra entero y no queda cortado por lo que tenga debajo. -->
                        <Border x:Name="AnilloHover" BorderBrush="{DynamicResource PincelMarca}"
                                BorderThickness="2" CornerRadius="{DynamicResource RadioCampo}"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX"
                                                         To="1.02" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY"
                                                         To="1.02" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Zoom" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- Con "reducir movimiento" el anillo y el realce siguen apareciendo:
                             son cambios de color, no movimiento. Lo unico que se saltea es el
                             zoom, que es lo que la preferencia del sistema pide evitar. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FondoHover" Property="Opacity" Value="1" />
                            <Setter TargetName="AnilloHover" Property="Opacity" Value="1" />
                        </MultiTrigger>

                        <!-- El "hundimiento" del criterio: se achica un instante al apretar y
                             vuelve al soltar, justo antes de quedar seleccionada. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Presion" Storyboard.TargetProperty="ScaleX"
                                                         To="0.98" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Presion" Storyboard.TargetProperty="ScaleY"
                                                         To="0.98" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Presion" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Presion" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- Elegida: el mismo lenguaje que las fichas de Chip, para que "esto
                             esta seleccionado" se lea igual en toda la app. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================================
         US-042 — las claves de Gemini, una por pestania.

         Es un TabControl con el strip ABAJO del contenido, como en el mockup: primero el
         campo de la clave seleccionada, y debajo la fila de pestanias con el boton de
         agregar al final. La plantilla se reescribe entera por ese boton: no hay forma de
         meter algo que no sea una pestania adentro del strip de un TabControl sin tocar su
         template, y ponerlo afuera lo separaba visualmente de las pestanias, que es lo que
         el mockup muestra pegado.

         El propio TabControl no dibuja ni fondo ni borde: la caja que se ve es la del campo
         de texto de adentro. Un marco alrededor de todo sumaba un segundo rectangulo sobre
         el del campo, y el bloque pasaba a leerse como un panel en vez de como un campo.
         ============================================================== -->
    <Style x:Key="PestanasDeClave" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter Grid.Row="0" ContentSource="SelectedContent" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />

                            <Button VerticalAlignment="Center"
                                    Style="{DynamicResource ChipAccion}"
                                    Content="{Binding EtiquetaDeAgregar}"
                                    Command="{Binding AgregarCommand}"
                                    FontFamily="{DynamicResource FuenteDato}"
                                    ToolTip="Agrega otra clave de Gemini: al agotarse la cuota de una, la app sigue con la siguiente"
                                    AutomationProperties.Name="Agregar otra clave de Gemini" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================================
         Una pestania de clave: la ficha chica con "clave N" y su cruz de borrar.

         La cruz vive adentro de la pestania y no en una barra aparte porque el criterio pide
         borrar la clave "desde su propia pestania". Se oculta cuando queda una sola: sin
         claves no habria donde escribir, y un boton que no se puede usar confunde mas que
         uno que no esta.

         El punto de la izquierda marca cual esta abierta. Es redundante con el fondo, a
         proposito: el fondo de la seleccionada es un violeta apagado y sobre papel la
         diferencia contra una pestania en reposo queda fina.
         ============================================================== -->
    <Style x:Key="PestanaDeClave" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Ficha" Padding="11,5"
                            CornerRadius="{DynamicResource RadioChip}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource PincelBorde}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Punto" Width="5" Height="5" Margin="0,0,7,0"
                                     VerticalAlignment="Center" Visibility="Collapsed"
                                     Fill="{DynamicResource PincelMarcaFuerte}" />

                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />

                            <Button x:Name="Quitar" Margin="8,0,0,0" Padding="0" MinWidth="0" MinHeight="0"
                                    Width="14" Height="14" VerticalAlignment="Center"
                                    Content="✕" FontSize="9"
                                    Foreground="{DynamicResource PincelTextoTenue}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Borra esta clave. Las demás no se tocan."
                                    AutomationProperties.Name="Borrar esta clave"
                                    Command="{Binding DataContext.QuitarCommand,
                                              RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding DataContext.PuedeQuitar,
                                                 RelativeSource={RelativeSource AncestorType=TabControl},
                                                 Converter={StaticResource EstilosBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ficha" Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                            <Setter TargetName="Ficha" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                            <Setter TargetName="Punto" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ficha" Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Ficha" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==============================================================
         US-047 — zona de riesgo.

         La tarjeta de "Restaurar valores de fabrica" no es una tarjeta mas: es la unica de
         Ajustes que no se puede deshacer. El borde rojizo y el fondo teñido son la senial que
         hace que no se lea como una opcion al pasar, y por eso el estilo se llama por lo que
         significa —una zona de riesgo— y no por su color: el dia que se sume otra accion
         irreversible a esta pantalla va a tener que verse igual.

         El rojo es el mismo PincelError de la correccion, sin un tono aparte: la app ya usa
         ese rojo para "esto salio mal", y una segunda familia de rojos solo diluiria las dos.
         ============================================================== -->
    <!-- ==============================================================
         US-051 — una accion presentada como tarjeta.

         "Exportar todo" e "Importar copia de seguridad" no son botones de una palabra: cada
         uno necesita decir su nombre y, debajo, que hace exactamente —sobre todo el de
         importar, que reemplaza lo que hay. Un boton comun con dos lineas de texto adentro se
         ve como un boton roto.

         Hereda de TarjetaAcceso, la tarjeta del menu principal (US-041), y solo le saca el
         alto minimo y el margen de grilla: el zoom leve y el anillo de acento al pasar el
         mouse que RN-53 fijo como estandar vienen con ella, sin repetir una animacion.
         ============================================================== -->
    <Style x:Key="TarjetaDeAccion" TargetType="Button" BasedOn="{StaticResource TarjetaAcceso}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="ZonaDeRiesgo" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="Background" Value="{DynamicResource PincelErrorSuave}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelError}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ==============================================================
         US-046 — un tramo de la barra de uso de disco.

         Cada uno se lleva su parte del ancho por un Grid de columnas en estrella (ver
         FraccionAEstrellaConverter), asi que aca solo va la forma. Redondeados y con un hueco
         entre si en vez de una barra continua: los tres tramos son magnitudes distintas —
         libros, historial, temporales— y el hueco es lo que deja contarlos de un vistazo sin
         tener que buscar donde cambia el color.
         ============================================================== -->
    <Style x:Key="TramoDeUso" TargetType="Border">
        <Setter Property="Height" Value="10" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Margin" Value="0,0,3,0" />
    </Style>

    <!-- ==============================================================
         US-046 / US-050 / US-054 — el punto de color de una referencia.

         Lo usan la leyenda de la barra de uso y cualquier lista donde un color signifique
         algo. Mismo tamanio que el punto de materia del resto de la app (US-027): dos puntos
         de referencia de distinto tamanio en la misma pantalla se leen como dos cosas
         distintas cuando son la misma idea.
         ============================================================== -->
    <Style x:Key="PuntoDeReferencia" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

</ResourceDictionary>
