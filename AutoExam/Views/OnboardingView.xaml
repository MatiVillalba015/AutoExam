<UserControl x:Class="AutoExam.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:AutoExam.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}">

    <Border Background="{DynamicResource PincelFondo}">
        <StackPanel MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">

            <TextBlock Text="AutoExam" Style="{StaticResource TxtTitulo}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource TxtSuave}" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,10,0,38"
                       Text="Examenes multiple choice a partir de tus PDF, corregidos con la escala de la UBA." />

            <TextBlock Text="API KEY DE GOOGLE GEMINI" Style="{StaticResource TxtRotulo}" />
            <ui:PasswordBox PlaceholderText="AQ.Ab8..." RevealButtonEnabled="True"
                            AutomationProperties.Name="API Key de Google Gemini"
                            Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Si tenés mas de una clave, pegalas separadas por comas: al agotarse la cuota diaria de una, AutoExam sigue con la siguiente."
                       Style="{StaticResource TxtDato}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <ui:HyperlinkButton Content="Conseguir una gratis en Google AI Studio"
                                NavigateUri="https://aistudio.google.com/app/apikey"
                                FontSize="11" Padding="0,4" HorizontalAlignment="Left" Margin="0,4,0,24" />

            <ui:Button Content="Verificar y empezar" Appearance="Primary"
                       HorizontalAlignment="Stretch" Padding="0,13" FontSize="14"
                       Command="{Binding VerificarCommand}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"
                        Visibility="{Binding Verificando, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" />
                <TextBlock Text="{Binding Paso}" Style="{StaticResource TxtSuave}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <ui:InfoBar Severity="Error" IsClosable="False" Margin="0,18,0,0"
                        Title="{Binding MensajeTitulo}" Message="{Binding Mensaje}"
                        IsOpen="{Binding HayMensaje, Mode=OneWay}" />

            <Button Content="Entrar sin verificar" Style="{StaticResource ChipAccion}"
                    HorizontalAlignment="Center" Margin="0,22,0,0"
                    Command="{Binding OmitirCommand}" />
        </StackPanel>
    </Border>
</UserControl>
