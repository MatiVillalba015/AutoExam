<UserControl x:Class="AutoExam.Views.BibliotecaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:AutoExam.Behaviors"
             xmlns:modelos="clr-namespace:AutoExam.Models"
             xmlns:vm="clr-namespace:AutoExam.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BibliotecaViewModel}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            US-045 / RN-53 — la misma luz violeta lejana que el Historial. Desde esta historia
            es el fondo estandar de la app: manchas de degradado radial que terminan en
            transparente, muy tenues, detras de todo y sin recibir mouse. La unica pantalla que
            no lo lleva es la configuracion inicial de la clave (US-042), que tiene el suyo.
        -->
        <Canvas Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="3" ClipToBounds="True"
                IsHitTestVisible="False" Panel.ZIndex="-1">
            <Ellipse Canvas.Left="-160" Canvas.Top="-220" Width="820" Height="820" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#3A2E6B" />
                        <GradientStop Offset="1" Color="#003A2E6B" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Canvas.Right="-240" Canvas.Bottom="-300" Width="900" Height="900" Opacity="0.28">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#2E2A5E" />
                        <GradientStop Offset="1" Color="#002E2A5E" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="&#x1F4DA; Libros" Style="{StaticResource TxtSeccion}"
                   Margin="0,0,0,18" />

        <!-- ============================================================ -->
        <!-- Columna izquierda: soltar un PDF y elegir de la lista         -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- US-023 — Materias.                                            -->
            <!--                                                               -->
            <!-- Va arriba de la zona de arrastre a proposito: la materia que  -->
            <!-- este elegida aca es la que recibe el material que se suelte   -->
            <!-- abajo, asi que elegirla antes es el orden natural de lectura. -->
            <!-- "Sin materia" no se puede renombrar ni borrar: es el cajon    -->
            <!-- por defecto de RN-22 y el destino al eliminar otra materia.   -->
            <!-- ============================================================ -->
            <ui:CardExpander Grid.Row="0" Icon="{ui:SymbolIcon Folder24}" ContentPadding="14"
                             Margin="0,0,0,14">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="Materias" Style="{StaticResource TxtCuerpo}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResumenMateriaElegida}" Style="{StaticResource TxtTenue}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </ui:CardExpander.Header>

                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Materias}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Chip}"
                                             GroupName="MateriasBiblioteca"
                                             AutomationProperties.Name="{Binding Nombre}"
                                             Command="{Binding DataContext.ElegirMateriaCommand,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding Nombre}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource SonIguales}" Mode="OneWay">
                                            <Binding Path="Nombre" />
                                            <Binding Path="DataContext.MateriaElegida"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>

                                    <!-- US-027: el punto de color es lo que hace que la
                                         materia se reconozca sin leer el nombre, y es el
                                         mismo color que despues pinta sus libros y sus
                                         examenes en el historial. -->
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                 Margin="0,0,8,0"
                                                 Fill="{Binding Color, Converter={StaticResource ColorMateria}}" />
                                        <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="NOMBRE" Style="{StaticResource TxtRotulo}" />
                    <ui:TextBox Text="{Binding MateriaNueva, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Nombre de la materia nueva, o nombre nuevo al renombrar"
                                PlaceholderText="Bioquimica" Margin="0,0,0,10" />

                    <!-- ============================================================ -->
                    <!-- US-027 — color de la materia elegida.                        -->
                    <!--                                                               -->
                    <!-- Paleta cerrada y no un selector RGB (RN-31): el color se       -->
                    <!-- dibuja como franja sobre fondo claro y oscuro, y un selector   -->
                    <!-- libre deja elegir tonos que desaparecen en uno de los dos      -->
                    <!-- temas. Los que todavia no usa ninguna materia se marcan, que   -->
                    <!-- es lo que pide el criterio: sugerir primero los libres sin     -->
                    <!-- prohibir repetir.                                              -->
                    <!-- ============================================================ -->
                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding HayMateriaElegida, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="COLOR" Style="{StaticResource TxtRotulo}" />
                        <ItemsControl ItemsSource="{Binding ColoresDisponibles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OpcionDeColor}">
                                    <Button Width="30" Height="30" Margin="0,0,8,8"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            Cursor="Hand"
                                            ToolTip="{Binding Ayuda}"
                                            AutomationProperties.Name="{Binding Ayuda}"
                                            Command="{Binding DataContext.ElegirColorCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Color}">
                                        <Grid>
                                            <Ellipse Width="26" Height="26"
                                                     Fill="{Binding Color, Converter={StaticResource ColorMateria}}" />
                                            <!-- El elegido lleva anillo; los libres, un punto
                                                 tenue. Sin esa distincion, "sugerir primero los
                                                 libres" no se ve en ningun lado. -->
                                            <Ellipse Width="30" Height="30" StrokeThickness="2"
                                                     Stroke="{DynamicResource PincelTexto}"
                                                     Visibility="{Binding EsElActual, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Bottom"
                                                     HorizontalAlignment="Center" Margin="0,0,0,-1"
                                                     Fill="{DynamicResource PincelTextoTenue}"
                                                     Visibility="{Binding EstaLibre, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <WrapPanel>
                        <ui:Button Content="Crear" Appearance="Primary" Padding="12,6" Margin="0,0,8,0"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Command="{Binding CrearMateriaCommand}"
                                   ToolTip="Crea una materia vacia con el nombre de arriba" />
                        <Button Content="Renombrar" Style="{StaticResource ChipAccion}"
                                Command="{Binding RenombrarMateriaCommand}"
                                IsEnabled="{Binding EsMateriaEditable}"
                                ToolTip="Le pone a la materia elegida el nombre de arriba. Sus documentos siguen adentro." />
                        <Button Content="Eliminar" Style="{StaticResource ChipAccion}"
                                Command="{Binding EliminarMateriaCommand}"
                                IsEnabled="{Binding EsMateriaEditable}"
                                ToolTip="Elimina la materia elegida. Pregunta que hacer con sus documentos." />
                    </WrapPanel>
                </StackPanel>
            </ui:CardExpander>

            <!--
                Es boton y zona de arrastre a la vez. Arrastrar nunca puede ser
                la unica forma de agregar un libro (WCAG 2.2, 2.5.7): el mismo
                control abre el selector de archivos con click o con Enter.
            -->
            <Button Grid.Row="1" Style="{StaticResource ZonaSoltar}" Margin="0,0,0,16"
                    Command="{Binding ElegirArchivoCommand}"
                    AutomationProperties.Name="Agregar material: PDF, Word, Excel, PowerPoint o imagenes. Solta los archivos aca o hace click para elegirlos"
                    beh:SoltarArchivo.Comando="{Binding SoltarCommand}"
                    beh:SoltarArchivo.Extensiones=".pdf .docx .xlsx .pptx .jpg .jpeg .png .heic .heif">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PincelMarca}" />
                    <TextBlock Text="Solta PDF, Word, Excel, PowerPoint o varias imagenes" Style="{StaticResource TxtCuerpo}"
                               HorizontalAlignment="Center" Margin="0,10,0,2" />
                    <TextBlock Text="o hace click para elegirlos" Style="{StaticResource TxtTenue}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- ============================================================ -->
            <!-- US-035 — buscador. Filtra la misma vista agrupada, asi que    -->
            <!-- buscar no aplana la lista: los resultados siguen saliendo     -->
            <!-- ordenados y agrupados por materia.                            -->
            <!-- ============================================================ -->
            <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Buscar por titulo, materia o archivo..."
                            Icon="{ui:SymbolIcon Search24}"
                            AutomationProperties.Name="Buscar en la biblioteca" />

                <Button Grid.Column="1" Content="Limpiar" Style="{StaticResource ChipAccion}"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Borra la busqueda y vuelve a mostrar todo el material"
                        Command="{Binding LimpiarFiltroCommand}"
                        Visibility="{Binding Filtro, Converter={StaticResource TextoAVisibilidad}}" />
            </Grid>

            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                        Visibility="{Binding SinResultados, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="Search24" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource PincelTextoTenue}" />
                <TextBlock Text="{Binding AvisoSinResultados}" Style="{StaticResource TxtCuerpo}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,4" />
                <TextBlock Text="Probá con otra palabra, o limpiá la búsqueda para ver todo."
                           Style="{StaticResource TxtTenue}" TextAlignment="Center" />
            </StackPanel>

            <!-- US-023: la lista va agrupada por materia, no como una tira plana. La vista
                 agrupada la arma el ViewModel (LibrosPorMateria) con agrupacion "en vivo",
                 asi que reasignar un libro lo mueve de grupo sin rearmar la lista. -->
            <ListBox Grid.Row="2" ItemsSource="{Binding LibrosPorMateria}" Margin="0,52,0,0"
                     SelectedItem="{Binding LibroSeleccionado, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ItemLibro}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Libros de la biblioteca, agrupados por materia">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <!--
                            US-030: cada materia es un grupo que se colapsa y se expande, con
                            una franja de su color (US-027 / RN-34, el mismo color que usa el
                            historial: no hay un esquema aparte).

                            Va como ContainerStyle y no como HeaderTemplate porque el Expander
                            tiene que envolver tambien a los items del grupo: un HeaderTemplate
                            solo puede dibujar el encabezado, y entonces no habria nada que
                            plegar. IsExpanded arranca en True para que la biblioteca siga
                            viendose entera de entrada, como hasta ahora.
                        -->
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True" Margin="0,10,0,2"
                                                      Background="Transparent" BorderThickness="0"
                                                      AutomationProperties.Name="{Binding Name}">
                                                <Expander.Header>
                                                    <Grid Margin="2,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Franja del color de la materia. Es
                                                             lo que permite ubicar un grupo sin
                                                             leer su nombre. -->
                                                        <Border Grid.Column="0" Width="4" Height="18"
                                                                CornerRadius="2" Margin="0,0,10,0"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding Name, Converter={StaticResource ColorDeMateriaPorNombre}}" />

                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   Style="{StaticResource TxtCuerpo}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <!-- El conteo evita contar a ojo para
                                                             saber si una materia quedo vacia
                                                             despues de reasignar. -->
                                                        <TextBlock Grid.Column="2" Text="{Binding ItemCount}"
                                                                   Style="{StaticResource TxtDato}"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Margin="8,0,6,0" />
                                                    </Grid>
                                                </Expander.Header>

                                                <ItemsPresenter Margin="0,4,0,0" />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type modelos:Libro}">
                        <StackPanel>
                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource TxtCuerpo}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Resumen}" Style="{StaticResource TxtTenue}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ============================================================ -->
        <!-- Columna derecha: ficha del libro abierto                      -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Grid.Column="2">

            <!-- Vacio: una sola instruccion, no un formulario apagado -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                        Visibility="{Binding HayLibroAbierto, Converter={StaticResource BoolAVisibilidad},
                                     ConverterParameter=invertir}">
                <ui:SymbolIcon Symbol="BookOpen24" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{DynamicResource PincelTextoTenue}" />
                <TextBlock Style="{StaticResource TxtSuave}" TextAlignment="Center" Margin="0,14,0,0"
                           Text="Solta un PDF a la izquierda o elegi un libro de la lista para editar su ficha." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                          Visibility="{Binding HayLibroAbierto, Converter={StaticResource BoolToVis}}">
                <!--
                    US-045 — el detalle ocupa todo el ancho disponible.

                    Antes era una columna de 640 px centrada, con la mitad de la pantalla vacia
                    al costado en un monitor ancho. Ahora: un encabezado grande arriba con lo
                    que identifica al libro y las dos acciones que lo cierran (guardar, quitar),
                    y debajo dos columnas — lo que se edita a la izquierda, lo que se lee a la
                    derecha. Ningun campo ni boton cambio: solo donde esta cada uno.
                -->
                <!--
                    Sin MaxWidth ni HorizontalAlignment a proposito, y las dos cosas por el
                    mismo motivo: un Grid con HorizontalAlignment="Center" se mide por su
                    contenido, asi que la columna * de abajo nunca se estira y la ficha queda
                    angosta con espacio muerto a los costados — justo lo que esta historia vino
                    a sacar. Estirado (el default) la ficha usa todo el ancho de la columna.

                    RN-13 se cumple donde importa, que es el largo de linea: el unico texto
                    largo de esta pantalla es el resumen de "De que trata", y ese si lleva su
                    tope propio mas abajo. Los campos, los botones y los modulos son cajas
                    cortas: estirarlos no hace ninguna linea ilegible.
                -->
                <Grid x:Name="FichaDelLibro">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ================================================================ -->
                    <!-- Encabezado: de que materia es, como se llama y sus datos.         -->
                    <!-- ================================================================ -->
                    <Border Grid.Row="0" Style="{StaticResource Tarjeta}" Padding="24,20" Margin="0,0,0,16"
                            Background="{DynamicResource PincelTarjetaProfunda}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Marca del archivo. No dice nada que no este escrito abajo: es
                                 el ancla visual que hace que la franja se lea como el
                                 encabezado del libro y no como una tarjeta mas. -->
                            <Border Grid.Column="0" Width="54" Height="54" Margin="0,0,18,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="{DynamicResource RadioTarjeta}"
                                    Background="{DynamicResource PincelMarcaSuave}">
                                <ui:SymbolIcon Symbol="Document24" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PincelMarcaFuerte}" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <!-- La materia primero y con su color: es lo que ubica al libro
                                     antes de leer el titulo, igual que la franja de la lista
                                     (US-027 / RN-34). -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0"
                                             Fill="{Binding ColorDeLaMateria, Converter={StaticResource ColorMateria}}" />
                                    <TextBlock Text="{Binding MateriaEnMayusculas}" Style="{StaticResource TxtRotulo}"
                                               Margin="0" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding TituloLibro}" Style="{StaticResource TxtTitulo}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                                <!-- Los mismos datos que antes iban en una linea sola, separados
                                     para que cada uno se encuentre sin leer los otros tres. -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding PaginasTexto}" Style="{StaticResource TxtDato}" />
                                    <TextBlock Text="·" Style="{StaticResource TxtTenue}" Margin="12,0" />
                                    <TextBlock Text="{Binding ArchivoTexto}" Style="{StaticResource TxtDato}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                    <TextBlock Text="·" Style="{StaticResource TxtTenue}" Margin="12,0" />
                                    <TextBlock Text="{Binding ResumenModulos}" Style="{StaticResource TxtDato}" />
                                    <TextBlock Text="·" Style="{StaticResource TxtTenue}" Margin="12,0" />
                                    <TextBlock Text="{Binding FechaSubidaTexto}" Style="{StaticResource TxtDato}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                        Margin="20,2,0,0">
                                <ui:Button Content="Guardar cambios" Appearance="Primary" Padding="18,10"
                                           ToolTip="Guarda el titulo, la materia y los modulos de este libro"
                                           Icon="{ui:SymbolIcon Save24}" Command="{Binding GuardarCommand}" />
                                <Button Content="Quitar libro" Style="{StaticResource ChipAccion}"
                                        ToolTip="Saca este material de la biblioteca y borra su copia interna. Pide confirmacion"
                                        Margin="10,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding QuitarCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ================================================================ -->
                    <!-- Cuerpo: lo que se edita a la izquierda, lo que se lee a la derecha -->
                    <!-- ================================================================ -->
                    <Grid Grid.Row="1">
                        <!-- Un tercio y dos tercios, en proporcion y no en pixeles: lo que se
                             edita son cuatro campos cortos y lo que se lee es un resumen mas la
                             grilla de modulos, asi que el ancho que se gana tiene que ir casi
                             todo a la derecha. Con un ancho fijo a la izquierda, en un monitor
                             grande la columna de edicion quedaba flaca al lado de la otra. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                    <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DATOS DEL LIBRO" Style="{StaticResource TxtRotulo}"
                                       Margin="0,0,0,14" />

                            <ui:InfoBar Severity="Error" IsClosable="False" Margin="0,0,0,18"
                                        Title="Falta el archivo PDF"
                                        Message="La copia interna no esta disponible. Volve a agregar el libro."
                                        IsOpen="{Binding FaltaElPdf, Mode=OneWay}" />

                            <TextBlock Text="TITULO" Style="{StaticResource TxtRotulo}" />
                            <ui:TextBox Text="{Binding TituloLibro, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Titulo del libro"
                                        PlaceholderText="Manual de Fisiologia" Margin="0,0,0,18" />

                            <TextBlock Text="MATERIA" Style="{StaticResource TxtRotulo}" />
                            <ui:TextBox Text="{Binding Materia, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Materia"
                                        PlaceholderText="Fisiologia" Margin="0,0,0,8" />

                            <!-- Materias ya usadas: un click en vez de volver a tipearlas
                                 (WCAG 2.2, 3.3.7 Entrada redundante). -->
                            <ItemsControl ItemsSource="{Binding MateriasConocidas}"
                                          Visibility="{Binding HayLibroAbierto, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipAccion}"
                                                Margin="0,0,6,6"
                                                AutomationProperties.Name="{Binding Nombre}"
                                                Command="{Binding DataContext.UsarMateriaCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Nombre}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                                             Fill="{Binding Color, Converter={StaticResource ColorMateria}}" />
                                                    <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                    <!-- ================================================================ -->
                    <!-- US-020 — "De que trata": resumen del material, bajo demanda.      -->
                    <!--                                                                   -->
                    <!-- El resumen NO se genera al subir el archivo (RN-17): cada uno      -->
                    <!-- cuesta una peticion de la cuota diaria, y la mayoria de los        -->
                    <!-- materiales no necesitan que se explique de que tratan. Se genera   -->
                    <!-- al tocar el boton, y despues queda guardado en el libro para no    -->
                    <!-- volver a pagarlo.                                                  -->
                    <!-- ================================================================ -->
                    <Border Style="{StaticResource TarjetaPlana}" Margin="0,0,0,16" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="De que trata" Style="{StaticResource TxtCuerpo}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Un resumen del contenido, sin abrir el archivo ni generar un examen."
                                               Style="{StaticResource TxtTenue}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Visibility="{Binding Resumiendo, Converter={StaticResource BoolToVis}}" />

                                    <Button Content="Ver de que trata" Style="{StaticResource ChipAccion}" ToolTip="Genera con IA un resumen de que trata este material, sin armar ningun examen"
                                            Command="{Binding VerDeQueTrataCommand}"
                                            AutomationProperties.Name="Ver de que trata este material" />

                                    <!-- US-045: pedir uno nuevo. Solo aparece cuando ya hay un
                                         resumen guardado: sin resumen previo, "Ver de que trata"
                                         ya genera el primero y los dos botones harian lo mismo.
                                         Gasta una peticion de la cuota, igual que la primera vez
                                         (RN-17), y por eso se dice en el tooltip. -->
                                    <Button Content="Volver a generar" Style="{StaticResource ChipAccion}"
                                            Margin="8,0,0,0"
                                            ToolTip="Pide un resumen nuevo en lugar del guardado. Gasta una peticion de tu cuota diaria"
                                            AutomationProperties.Name="Volver a generar el resumen de este material"
                                            Command="{Binding VolverAGenerarCommand}"
                                            Visibility="{Binding TieneResumenGuardado, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,16,0,0" Padding="16"
                                    Background="{DynamicResource PincelSuperficie}"
                                    BorderBrush="{DynamicResource PincelBorde}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RadioCampo}"
                                    Visibility="{Binding MostrarDeQueTrata, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Leyendo el material y armando el resumen..."
                                               Style="{StaticResource TxtTenue}"
                                               Visibility="{Binding Resumiendo, Converter={StaticResource BoolToVis}}" />

                                    <!-- US-017 / RN-13 — el tope de ancho vive aca y no en la
                                         ficha entera. Es el unico parrafo largo de la pantalla:
                                         a ancho completo en un monitor grande una linea cruzaria
                                         el escritorio y se volveria incomoda de leer. Centrado
                                         porque el texto adentro sigue alineado a la izquierda:
                                         lo que se centra es la columna, no los renglones. -->
                                    <TextBlock Text="{Binding TextoDeQueTrata}" Style="{StaticResource TxtCuerpo}"
                                               TextWrapping="Wrap" LineHeight="21"
                                               MaxWidth="920" HorizontalAlignment="Center"
                                               Visibility="{Binding TextoDeQueTrata, Converter={StaticResource TextoAVisibilidad}}" />

                                    <Button Content="Cerrar" Style="{StaticResource ChipAccion}"
                                            HorizontalAlignment="Left" Margin="0,14,0,0"
                                            Command="{Binding CerrarDeQueTrataCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- US-045: abierto de entrada. Antes venia plegado porque el detalle era una
                         columna angosta y los modulos eran una tira vertical larga que empujaba
                         todo lo demas fuera de la pantalla. Ahora son dos columnas en la mitad
                         derecha y entran a la vista sin tapar nada, asi que esconderlos solo
                         agregaba un click para ver de que partes esta hecho el libro. -->
                    <ui:CardExpander Icon="{ui:SymbolIcon BookNumber24}" ContentPadding="18" Margin="0,0,0,16"
                                     IsExpanded="True">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Text="Modulos y capitulos" Style="{StaticResource TxtCuerpo}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ResumenModulos}" Style="{StaticResource TxtTenue}" />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- ============================================================ -->
                            <!-- US-045 — los modulos, en una grilla de dos columnas.          -->
                            <!--                                                               -->
                            <!-- Cada uno con su etiqueta (M1, M2...), su nombre y el rango de  -->
                            <!-- paginas que cubre. Dos columnas y no una lista vertical porque -->
                            <!-- un libro con veinte capitulos se leia como una tira larga que  -->
                            <!-- no entraba en pantalla.                                        -->
                            <!--                                                               -->
                            <!-- Es solo lectura: editarlos sigue siendo la grilla de abajo,    -->
                            <!-- que es donde se les cambia el nombre y el rango.               -->
                            <!-- ============================================================ -->
                            <ItemsControl ItemsSource="{Binding Modulos}" Margin="0,0,0,16"
                                          AlternationCount="999"
                                          Visibility="{Binding HayModulos, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type modelos:Modulo}">
                                        <Grid Margin="0,0,10,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- La etiqueta sale de la posicion del modulo en la
                                                 lista, no de un campo nuevo: renumerar al agregar
                                                 o quitar uno tiene que ser gratis. -->
                                            <Border Grid.Column="0" Padding="7,2" Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="{DynamicResource RadioCampo}"
                                                    Background="{DynamicResource PincelMarcaSuave}">
                                                <TextBlock Style="{StaticResource TxtDato}" FontSize="11"
                                                           Foreground="{DynamicResource PincelMarcaFuerte}">
                                                    <Run Text="M" /><Run Text="{Binding (ItemsControl.AlternationIndex),
                                                                                RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                                                Mode=OneWay, Converter={StaticResource MasUno}}" />
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Column="1" Text="{Binding Nombre}"
                                                       Style="{StaticResource TxtCuerpo}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                                            <TextBlock Grid.Column="2" Style="{StaticResource TxtDato}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Run Text="pag." /><Run Text=" " /><Run Text="{Binding DesdePagina, Mode=OneWay}" /><Run Text="–" /><Run Text="{Binding HastaPagina, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="EDITAR MODULOS" Style="{StaticResource TxtRotulo}"
                                       Margin="0,0,0,10" />

                            <WrapPanel Margin="0,0,0,14">
                                <!-- Primero, y con el acento: es lo que hay que tocar. Cargar
                                     veinte capitulos a mano es lo que nadie quiere hacer. -->
                                <ui:Button Content="Detectar capitulos del PDF" Appearance="Primary"
                                           Margin="0,0,8,0" Padding="14,7"
                                           Icon="{ui:SymbolIcon TextBulletListTree24}"
                                           Command="{Binding DetectarCapitulosCommand}"
                                           ToolTip="Lee el indice interno del PDF y arma un modulo por capitulo" />
                                <Button Content="Agregar modulo" Style="{StaticResource ChipAccion}" ToolTip="Suma un tramo de paginas con nombre propio, para poder acotar el examen a el"
                                        Command="{Binding AgregarModuloCommand}" />
                                <Button Content="Quitar el ultimo" Style="{StaticResource ChipAccion}" ToolTip="Borra el ultimo modulo de la lista"
                                        Command="{Binding QuitarModuloCommand}" />
                            </WrapPanel>

                            <ui:DataGrid ItemsSource="{Binding Modulos}" AutoGenerateColumns="False"
                                         MaxHeight="240" CanUserAddRows="False" HeadersVisibility="Column"
                                         GridLinesVisibility="Horizontal" Margin="0,0,0,16"
                                         AutomationProperties.Name="Modulos del libro"
                                         Visibility="{Binding HayModulos, Converter={StaticResource BoolToVis}}">
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Width="*"
                                                        Binding="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Desde" Width="80"
                                                        Binding="{Binding DesdePagina, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Hasta" Width="80"
                                                        Binding="{Binding HastaPagina, UpdateSourceTrigger=PropertyChanged}" />
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>

                            <Border Style="{StaticResource TarjetaPlana}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Dividir el libro en partes iguales"
                                               Style="{StaticResource TxtCuerpo}" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource TxtTenue}" Margin="0,0,0,12"
                                               Text="Util cuando el PDF no trae capitulos claros. Reemplaza los modulos actuales." />

                                    <StackPanel Orientation="Horizontal">
                                        <ui:NumberBox Value="{Binding PartesParaDividir, Mode=TwoWay}"
                                                      Minimum="1" Maximum="200" Width="90"
                                                      AutomationProperties.Name="Cantidad de partes"
                                                      ClearButtonEnabled="False" />
                                        <Button Content="Dividir" Style="{StaticResource ChipAccion}" ToolTip="Parte el libro en modulos de igual cantidad de paginas"
                                                Margin="10,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding DividirCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ui:CardExpander>

                    </StackPanel>
                    </Grid>

                    <ui:InfoBar Grid.Row="2" Margin="0,18,0,20" IsClosable="True" Title=""
                                Message="{Binding Mensaje}"
                                IsOpen="{Binding HayMensaje, Mode=OneWay}"
                                Severity="{Binding Severidad, Converter={StaticResource Severidad}}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
