<!--
    Sistema visual de AutoExam.

    Reglas que sostienen todo lo de abajo:
    · Un solo lugar define color, radio, sombra y tipografia. Ningun color literal
      vive en una vista.
    · Los pinceles toman el Color con DynamicResource, asi que cambiar de tema es
      intercambiar Tokens.Claro/Tokens.Oscuro sin recrear un solo estilo.
    · La familia mono se reserva para datos que se comparan de un vistazo
      (cronometro, nota, paginas). El texto que se lee corrido nunca es mono.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:comportamientos="clr-namespace:AutoExam.Behaviors">

    <!-- Convertidor propio y no el "BoolToVis" de App.xaml: este diccionario se fusiona
         ANTES de que App.xaml declare sus convertidores, y un StaticResource se resuelve al
         cargar el diccionario que lo escribe. Plantillas.xaml resuelve lo mismo igual. -->
    <BooleanToVisibilityConverter x:Key="EstilosBoolToVis" />

    <!-- ==============================================================
         Tooltips (US-029).

         "Given un boton no tiene ya una descripcion visible de forma permanente,
         when paso el mouse por encima y lo mantengo, then aparece una breve
         descripcion de que hace ese boton DEBAJO de el."

         Va como estilo implicito (sin x:Key) y no como atributo repetido en cada
         boton: el lugar donde aparece el globo es una decision del sistema visual,
         no de cada vista, y asi ninguna pantalla puede quedarse afuera. Placement
         es propiedad del propio ToolTip, asi que una sola regla alcanza para toda
         la app; ToolTipService.Placement, en cambio, habria que ponerlo boton por
         boton.

         El retardo es el del sistema a proposito: el criterio dice "y lo mantengo".
         Un globo instantaneo aparece tambien cuando uno solo esta pasando el mouse
         camino a otra cosa.
         ============================================================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="HorizontalOffset" Value="0" />
        <Setter Property="VerticalOffset" Value="6" />
        <Setter Property="MaxWidth" Value="280" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="{DynamicResource PincelTarjeta}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadioCampo}"
                            Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource SombraTarjeta}">
                        <!-- TextWrapping para que una descripcion de dos lineas no salga
                             como una tira de 600 px cruzando la pantalla. -->
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- ============================================================== -->
    <!-- Escalas. Los pinceles y la sombra viven en Theme/Tokens.*.xaml   -->
    <!-- ============================================================== -->
    <CornerRadius x:Key="RadioTarjeta">14</CornerRadius>
    <CornerRadius x:Key="RadioCampo">10</CornerRadius>
    <CornerRadius x:Key="RadioChip">18</CornerRadius>

    <!-- ==============================================================
         Tipografia (US-028 / RN-32).

         Cada familia es una CADENA de respaldo, no una fuente sola: WPF baja al
         siguiente nombre cuando el anterior no esta instalado. Por eso la app se ve
         igual de prolija en un Windows 11 (que trae Segoe UI Variable) que en un
         Windows 10 que solo tiene Segoe UI, sin ningun chequeo en codigo.

         "Inter" va primera aunque Windows no la traiga: si el usuario la instala
         alguna vez, la app la toma sola; si no, cae a la de siempre y no se nota.
         Nunca queda un hueco ni una fuente ajena: el ultimo eslabon de cada cadena
         es una familia que existe en todo Windows soportado.

         Los tamanios son la UNICA fuente de verdad de la escala: ninguna vista
         escribe un FontSize literal (RN-32). El de la pantalla de examen no esta
         aca sino en ExamenViewModel, porque el alumno lo ajusta en vivo (US-005);
         ahi tambien hay un solo lugar que lo define.
         ============================================================== -->
    <FontFamily x:Key="FuenteTitulo">Inter Display, Inter, Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteCuerpo">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteDato">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Escala afinada: los titulos bajan (30 era tamanio de portada, no de seccion) y
         el cuerpo sube medio punto. El contraste entre niveles se apoya mas en el peso
         y en el espaciado que en el salto de tamanio, que es lo que hacia que la
         pantalla se viera cargada. -->
    <!-- Un escalon por encima de TamTitulo, reservado a la portada: hoy lo usa solamente el
         "AutoExam" de la configuracion inicial (US-042), que es lo primero que ve alguien que
         abre la app y no tiene con que competir en esa pantalla. Adentro de la app no se usa:
         ahi el titulo mas grande sigue siendo TamTitulo. -->
    <sys:Double x:Key="TamHeroe">46</sys:Double>
    <sys:Double x:Key="TamTitulo">26</sys:Double>
    <sys:Double x:Key="TamSeccion">19</sys:Double>
    <sys:Double x:Key="TamEnunciado">16</sys:Double>
    <sys:Double x:Key="TamCuerpo">14</sys:Double>
    <sys:Double x:Key="TamMenor">12.5</sys:Double>
    <sys:Double x:Key="TamMinimo">11</sys:Double>

    <!-- ============================================================== -->
    <!-- Animacion. Duration/EasingFunction no son Freezables con estado -->
    <!-- propio (no se "gastan" al compartirlos), asi que una sola       -->
    <!-- instancia de cada uno alcanza para todos los templates de abajo.-->
    <!-- ============================================================== -->
    <Duration x:Key="DuracionHover">0:0:0.14</Duration>
    <Duration x:Key="DuracionPresion">0:0:0.13</Duration>
    <QuadraticEase x:Key="SuavizadoSalida" EasingMode="EaseOut" />
    <!-- Transicion de seccion del shell (US-007, Behaviors/TransicionContenido.cs). Mismo
         criterio de instancia unica que las dos de arriba. -->
    <Duration x:Key="DuracionTransicionSeccion">0:0:0.22</Duration>

    <!-- ============================================================== -->
    <!-- Tipografia                                                      -->
    <!-- ============================================================== -->
    <!-- Peso SemiBold y no Light: a 26px el Light se veia desvaido y sin jerarquia. Lo que
         separa un titulo de un parrafo grande ahora es el peso, no el tamanio, que es lo que
         permitio bajar la escala sin perder lectura. -->
    <!-- Portada (US-042). Mismo sistema que TxtTitulo, un escalon mas grande y sin ajuste de
         linea: es un nombre propio de una palabra, no una frase. -->
    <Style x:Key="TxtHeroe" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteTitulo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamHeroe}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="TxtTitulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteTitulo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamTitulo}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="TxtSeccion" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteTitulo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamSeccion}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TxtCuerpo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamCuerpo}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <!-- Contexto secundario. Color propio, no opacidad: la opacidad tambien
         apaga los bordes y los iconos que caen dentro del mismo contenedor. -->
    <Style x:Key="TxtSuave" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMenor}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoSuave}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TxtTenue" TargetType="TextBlock" BasedOn="{StaticResource TxtSuave}">
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoTenue}" />
    </Style>

    <!-- Rotulo de campo en versalitas: separa la etiqueta del dato sin usar negrita,
         que a este tamanio compite con el titulo de la seccion. -->
    <Style x:Key="TxtRotulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoTenue}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <!-- El rotulo se lee como etiqueta y no como texto. A este tamanio el espaciado
             entre letras hace ese trabajo mejor que subir el peso, que ya esta usado. -->
        <Setter Property="TextBlock.LineHeight" Value="15" />
    </Style>

    <!--
        Texto de ayuda debajo de un rotulo de seccion (US-030).

        Existe como estilo propio y no como un TxtTenue con margenes a mano porque el
        problema que resuelve es de ritmo, no de una pantalla puntual: la aclaracion de
        "Capitulos", la de "Materia" y la de "Eje tematico" venian cada una con su propio
        margen, y en dos de las tres quedaba pegada al rotulo de arriba. Al ser una sola
        regla, el espacio sobre el texto y el interlineado son los mismos en toda la app.

        LineStackingStrategy es necesario: sin el, LineHeight en WPF se interpreta como un
        minimo y el interlineado real lo sigue fijando la fuente, asi que el valor no
        tendria ningun efecto visible a este tamanio.
    -->
    <Style x:Key="TxtAyuda" TargetType="TextBlock" BasedOn="{StaticResource TxtTenue}">
        <Setter Property="Margin" Value="0,2,0,14" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="TxtDato" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteDato}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMenor}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoSuave}" />
    </Style>

    <!-- Texto que se puede arrastrar con el mouse para copiar. TextBox de solo
         lectura con template minimo: identico a un TextBlock a la vista. -->
    <Style x:Key="TextoSeleccionable" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamCuerpo}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Command="Copy" Header="Copiar" />
                    <MenuItem Command="SelectAll" Header="Seleccionar todo" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Tarjetas                                                        -->
    <!--                                                                 -->
    <!-- US-030 pide una jerarquia visual entre tres tipos de tarjeta:    -->
    <!-- la informativa (lo que hay), la seleccionable (lo que se elige)  -->
    <!-- y el resumen o bloque protagonista de la pantalla. La diferencia -->
    <!-- se lleva en la profundidad, no en el color: cambiar el fondo de  -->
    <!-- cada tipo obligaria a un tono distinto por tema y por estado, y  -->
    <!-- terminaria compitiendo con el color de materia (US-027) y con    -->
    <!-- los de correcto/incorrecto, que son los unicos que significan    -->
    <!-- algo. La sombra ordena sin decir nada.                           -->
    <!-- ============================================================== -->

    <!-- Nivel 2 de 3 — informativa. Es el default historico de la app y sigue      -->
    <!-- siendo el que usan las tarjetas que solo muestran algo.                    -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PincelTarjeta}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadioTarjeta}" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Effect" Value="{DynamicResource SombraTarjeta}" />
    </Style>

    <!-- Nivel 1 de 3 — seleccionable. Va mas al ras que una informativa a proposito:
         lo que se elige tiene que verse disponible, no ya resuelto. Es la que usan las
         listas de items que se tildan (documentos, examenes del historial), donde ademas
         hay muchas juntas y apilar sombras profundas ensucia la pantalla entera. -->
    <Style x:Key="TarjetaSeleccionable" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="Effect" Value="{DynamicResource SombraTarjetaSuave}" />
        <!-- US-043: la superficie deja de ser plana y toma un degradado vertical minimo. Lo
             que cambia es solo la sensacion de volumen; el color, el borde y la sombra son
             los mismos, asi que ninguna tarjeta cambia de nivel en la jerarquia de US-030. -->
        <Setter Property="Background" Value="{DynamicResource PincelTarjetaProfunda}" />
    </Style>

    <!-- Nivel 3 de 3 — resumen / bloque protagonista. La usan el resumen de "vas a
         generar", la tarjeta del resultado y el enunciado de la pregunta en el examen:
         es lo unico que tiene que ganarle visualmente a todo lo demas de su pantalla.
         El borde de 2 px acompania a la sombra porque en tema oscuro la profundidad sola
         no alcanza para separar la tarjeta del fondo. -->
    <Style x:Key="TarjetaResumen" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="Effect" Value="{DynamicResource SombraTarjetaElevada}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
    </Style>

    <!-- Variante sin sombra para tarjetas anidadas: apilar sombras ensucia. -->
    <Style x:Key="TarjetaPlana" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource PincelSuperficie}" />
    </Style>

    <!-- Variante de TarjetaPlana para un aviso, no para informacion neutra: usa el
         mismo par de pinceles que el chip seleccionado (PincelMarcaSuave/PincelMarca),
         asi que "esto necesita tu atencion" se lee con el mismo lenguaje de color que
         ya tiene el resto de la app en vez de inventar un tono de alerta nuevo. Sigue
         siendo Nivel 1 (sin sombra): un aviso no compite en profundidad con el resumen
         final, compite en color. -->
    <Style x:Key="TarjetaAviso" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
    </Style>

    <!-- ============================================================== -->
    <!-- Chips: la seleccion rapida que reemplaza a los campos de texto   -->
    <!-- ============================================================== -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMenor}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- 32 px de alto minimo: blanco de click comodo tambien con el trackpad. -->
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadioChip}"
                                SnapsToDevicePixels="True" />
                        <!-- Overlay de hover: nunca se anima el Brush de "Fondo" directo (rompería
                             el cambio de tema); se anima la Opacity de esta capa, pintada con el
                             mismo pincel que antes se asignaba instantáneo por Setter. -->
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioChip}" Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- RN-38: el contenido va DESPUES del overlay, no adentro del fondo.
                             PincelTarjetaHover es opaco, asi que con el contenido debajo la capa
                             de hover lo tapaba entero al llegar a Opacity 1. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1.01" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1.01" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="AnilloHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <!-- Seleccionado: relleno + borde + texto de marca. El estado no
                             depende solo del color, tambien cambia el peso del texto. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                            <Setter Property="Foreground" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante de Chip con relleno solido cuando esta seleccionado, en vez del tinte
         suave de Chip. Nace para las tres filas de preset del Asistente (paginas,
         cantidad de preguntas, tiempo): son grupos chicos y excluyentes (RadioButton,
         uno solo activo a la vez) donde cual quedo elegido es la decision central de
         ese renglon, asi que conviene que se vea resuelta de un vistazo en vez de
         competir en el mismo tono que un chip de capitulos que se puede tildar de a
         varios. Es una copia de Chip y no un Trigger agregado por BasedOn porque el
         Template completo (con sus Triggers) se hereda como un solo valor atomico: no
         hay forma de "parchear" un Trigger de adentro de un ControlTemplate heredado. -->
    <Style x:Key="ChipDestacado" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMenor}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBordeFuerte}" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadioChip}"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioChip}" Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1.01" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1.01" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <!-- Unica diferencia real con Chip: relleno solido de marca y texto
                             sobre-marca en vez del tinte suave. Mismo criterio de contraste
                             que ya usa el circulo del paso activo en el riel del Asistente. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource PincelMarca}" />
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                            <Setter Property="Foreground" Value="{DynamicResource PincelSobreMarca}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource PincelMarcaFuerte}" />
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip que ejecuta una accion en vez de mantener estado (ej. "Marcar todos"). -->
    <Style x:Key="ChipAccion" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FuenteCuerpo}" />
        <Setter Property="FontSize" Value="{DynamicResource TamMinimo}" />
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoSuave}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Raiz" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fondo" Background="Transparent"
                                BorderBrush="{DynamicResource PincelBorde}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadioChip}" />
                        <Border x:Name="FondoHover" Background="{DynamicResource PincelTarjetaHover}"
                                CornerRadius="{DynamicResource RadioChip}" Opacity="0"
                                IsHitTestVisible="False" />
                        <!-- RN-38: el contenido va sobre el overlay opaco de hover, no debajo. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PincelTexto}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-011 / NFR-47: no dispara con "reducir movimiento" del SO activo. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FondoHover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DuracionHover}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                                <!-- US-029 / RN-33: el pulsado tampoco se anima con "reducir movimiento" del SO.
                                     Esta condicion faltaba solo en el pulsado: el resto de la app ya respetaba la
                                     preferencia, pero el boton seguia dando el saltito igual. -->
                                <Condition Property="comportamientos:Animaciones.MovimientoReducido" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="0.985" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                        <DoubleAnimation Storyboard.TargetName="Escala" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DuracionPresion}"
                                                         EasingFunction="{StaticResource SuavizadoSalida}" />
                                    </Storyboard>
