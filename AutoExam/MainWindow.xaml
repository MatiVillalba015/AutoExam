<ui:FluentWindow x:Class="AutoExam.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:AutoExam.ViewModels"
                 xmlns:vistas="clr-namespace:AutoExam.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
                 Title="AutoExam"
                 Width="1240" Height="820"
                 MinWidth="980" MinHeight="660"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource PincelFondo}"
                 Loaded="Ventana_Loaded"
                 Closing="Ventana_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AutoExam" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BookOpen24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============================================================ -->
        <!-- Cuerpo: navegacion lateral + pagina activa                    -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navegacion. Un RadioButton por pagina: el grupo por contenedor
                 garantiza que siempre haya exactamente una activa. -->
            <StackPanel Grid.Column="0" Margin="20,10,10,20">
                <ItemsControl ItemsSource="{Binding Paginas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PaginaViewModel}">
                            <RadioButton Style="{StaticResource ItemNavegacion}"
                                         AutomationProperties.Name="{Binding Titulo}"
                                         Command="{Binding DataContext.IrACommand,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Clave}"
                                         IsEnabled="{Binding Habilitada}"
                                         IsChecked="{Binding EsActual, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icono}"
                                                   FontSize="17" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Titulo}" />
                                        <TextBlock Text="{Binding Insignia}" Style="{StaticResource TxtTenue}"
                                                   Visibility="{Binding Insignia, Converter={StaticResource TextoAVisibilidad}}" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Pagina activa: WPF elige la vista por el tipo del ViewModel
                 (los DataTemplate viven en App.xaml). -->
            <ContentControl Grid.Column="1" Content="{Binding Pagina}" Margin="10,10,26,0"
                            Focusable="False" />
        </Grid>

        <!-- ============================================================ -->
        <!-- Barra de estado                                               -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Padding="26,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource PincelBorde}">
            <Grid>
                <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource TxtTenue}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding EstadoApi}" Style="{StaticResource TxtDato}"
                               FontSize="11" VerticalAlignment="Center" />

                    <TextBlock Text="·" Style="{StaticResource TxtDato}" FontSize="11"
                               Margin="8,0" VerticalAlignment="Center" />

                    <!-- Version instalada: es lo que hay que mirar para saber si una
                         actualizacion realmente se aplico. -->
                    <TextBlock Text="{Binding Version}" Style="{StaticResource TxtDato}"
                               FontSize="11" VerticalAlignment="Center"
                               ToolTip="Version instalada de AutoExam" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Pantalla de inicio: configurar y verificar antes de entrar     -->
        <!-- ============================================================ -->
        <vistas:OnboardingView Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="10"
                               DataContext="{Binding Onboarding}"
                               Visibility="{Binding DataContext.MostrarBienvenida,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource BoolToVis}}" />
    </Grid>
</ui:FluentWindow>
