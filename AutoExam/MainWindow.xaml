<ui:FluentWindow x:Class="AutoExam.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:AutoExam.ViewModels"
                 xmlns:vistas="clr-namespace:AutoExam.Views"
                 xmlns:comportamientos="clr-namespace:AutoExam.Behaviors"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
                 Title="AutoExam"
                 Width="1240" Height="820"
                 MinWidth="980" MinHeight="660"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource PincelFondo}"
                 Loaded="Ventana_Loaded"
                 Closing="Ventana_Closing">

    <!--
        Navegacion por teclado entre secciones (US-004). Van a nivel Window, no en
        ExamenView.xaml: por estar en un scope distinto (Window vs. UserControl de
        Examen) y no compartir tecla con sus KeyBinding (1-4, NumPad1-4, A-D, flechas,
        Enter, S), no interfieren por construccion. Ctrl+1..5 = orden de Paginas
        (Libros, Nuevo examen, Examen, Historial, Ajustes). El no-disparo con foco en
        un campo de texto (NFR-10) lo resuelve ShellViewModel.PuedeIrA (CanExecute de
        IrACommand), no algo declarado aca.
    -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding IrACommand}" CommandParameter="libros" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding IrACommand}" CommandParameter="nuevo" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding IrACommand}" CommandParameter="examen" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding IrACommand}" CommandParameter="historial" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding IrACommand}" CommandParameter="ajustes" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AutoExam" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BookOpen24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============================================================ -->
        <!-- US-048 / RN-56 — el zoom de toda la interfaz, en un solo lugar -->
        <!--                                                               -->
        <!-- Un unico ScaleTransform envolviendo el contenido, y no un      -->
        <!-- tamanio de fuente por pantalla: asi escalan tambien los        -->
        <!-- iconos, los paddings y los bordes, y ninguna pantalla puede    -->
        <!-- quedarse afuera por olvido. Va en LayoutTransform y no en      -->
        <!-- RenderTransform porque el layout tiene que rehacerse con el    -->
        <!-- tamanio nuevo: con RenderTransform el contenido se agrandaria  -->
        <!-- por encima de la ventana y quedaria cortado.                   -->
        <!--                                                               -->
        <!-- La barra de titulo queda afuera a proposito: es cromo de la    -->
        <!-- ventana de Windows, y agrandar los botones de minimizar y      -->
        <!-- cerrar los desalinearia del borde.                             -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
            </Grid.LayoutTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Cuerpo: barra de seccion + pagina activa                      -->
        <!--                                                               -->
        <!-- US-030: la barra lateral fija de 228 px se reemplazo por la    -->
        <!-- pantalla de inicio (InicioView) con una grilla de 4 tarjetas.  -->
        <!-- Sacar la columna no es solo estetico: el contenido de cada     -->
        <!-- seccion pasa a disponer del ancho completo, que es lo que le   -->
        <!-- da margen real al centrado de US-017 (RN-35).                  -->
        <!--                                                               -->
        <!-- Lo unico que queda fijo es una barra fina con el nombre de la  -->
        <!-- seccion abierta y el boton de volver al inicio, que aparece    -->
        <!-- solo cuando hay una seccion abierta. La navegacion por teclado -->
        <!-- (Ctrl+1..5) sigue funcionando igual, sin pasar por el inicio.  -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="26,4,26,10" Padding="0,0,0,10"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PincelBorde}"
                    Visibility="{Binding EnUnaSeccion, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" Padding="10,6"
                               Icon="{ui:SymbolIcon Home24}" Content="Inicio"
                               ToolTip="Volver a la pantalla de inicio"
                               AutomationProperties.Name="Volver a la pantalla de inicio"
                               Command="{Binding IrAInicioCommand}" />

                    <TextBlock Text="/" Style="{StaticResource TxtTenue}" Margin="12,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding TituloSeccion}" Style="{StaticResource TxtCuerpo}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Pagina activa: WPF elige la vista por el tipo del ViewModel (los
                 DataTemplate viven en App.xaml). El inicio entra por el mismo
                 ContentControl que las demas, asi que la transicion suave entre
                 pantallas (US-029) cubre tambien ir y volver del inicio. -->
            <ContentControl Grid.Row="1" Content="{Binding Pagina}" Margin="26,0,26,0"
                            Focusable="False" comportamientos:TransicionContenido.Activa="True" />
        </Grid>

        <!-- ============================================================ -->
        <!-- Barra de estado                                               -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Padding="26,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource PincelBorde}">
            <Grid>
                <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource TxtTenue}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding EstadoApi}" Style="{StaticResource TxtDato}"
                               FontSize="11" VerticalAlignment="Center" />

                    <TextBlock Text="·" Style="{StaticResource TxtDato}" FontSize="11"
                               Margin="8,0" VerticalAlignment="Center" />

                    <!-- Version instalada: es lo que hay que mirar para saber si una
                         actualizacion realmente se aplico. -->
                    <TextBlock Text="{Binding Version}" Style="{StaticResource TxtDato}"
                               FontSize="11" VerticalAlignment="Center"
                               ToolTip="Version instalada de AutoExam" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- US-050 — aviso informativo                                    -->
        <!--                                                               -->
        <!-- Adentro de la ventana y no una notificacion de Windows: es lo  -->
        <!-- que pide RN-58, y ademas es lo unico que tiene sentido en una  -->
        <!-- app que se usa en primer plano. Flota sobre el contenido,      -->
        <!-- justo arriba de la barra de estado, y se va solo a los seis    -->
        <!-- segundos. No es hit-testeable salvo su boton de cerrar: un     -->
        <!-- aviso no puede robarle un click a lo que hay debajo.           -->
        <!--                                                               -->
        <!-- Nunca muestra errores ni confirmaciones: esos van por          -->
        <!-- IDialogos y por la InfoBar de cada pantalla, que no pasan por  -->
        <!-- aca. Es lo que hace que apagar las notificaciones no pueda     -->
        <!-- silenciar nada importante.                                     -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Panel.ZIndex="9" Margin="26,0,26,16"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                MaxWidth="520" Padding="16,12"
                Background="{DynamicResource PincelTarjeta}"
                BorderBrush="{DynamicResource PincelMarca}" BorderThickness="1"
                CornerRadius="{DynamicResource RadioTarjeta}"
                Visibility="{Binding HayAviso, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" VerticalAlignment="Center"
                               Margin="0,0,12,0" Foreground="{DynamicResource PincelMarca}" />

                <TextBlock Text="{Binding Aviso}" Style="{StaticResource TxtCuerpo}"
                           TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="400" />

                <Button Content="✕" Style="{StaticResource ChipAccion}" Margin="14,0,0,0"
                        VerticalAlignment="Center" Padding="8,3"
                        AutomationProperties.Name="Cerrar el aviso"
                        Command="{Binding CerrarAvisoCommand}" />
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Pantalla de inicio: configurar y verificar antes de entrar     -->
        <!-- ============================================================ -->
        <vistas:OnboardingView Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10"
                               DataContext="{Binding Onboarding}"
                               Visibility="{Binding DataContext.MostrarBienvenida,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
