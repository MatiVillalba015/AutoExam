<UserControl x:Class="AutoExam.Views.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:servicios="clr-namespace:AutoExam.Services"
             xmlns:vm="clr-namespace:AutoExam.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AjustesViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
        <StackPanel MaxWidth="620" HorizontalAlignment="Center">

            <TextBlock Text="Ajustes" Style="{StaticResource TxtSeccion}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="API KEYS DE GOOGLE GEMINI" Style="{StaticResource TxtRotulo}" />
                    <ui:PasswordBox PlaceholderText="AQ.Ab8...,  AQ.Ab8...  (separalas con comas)"
                                    RevealButtonEnabled="True" Margin="0,0,0,6"
                                    AutomationProperties.Name="API Keys de Google Gemini, separadas por comas"
                                    Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding ResumenClaves}" Style="{StaticResource TxtDato}"
                               TextWrapping="Wrap" Margin="0,0,0,18" />

                    <TextBlock Text="MODELO" Style="{StaticResource TxtRotulo}" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" IsEditable="True" ItemsSource="{Binding Modelos}"
                                  Text="{Binding Modelo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="Modelo de Gemini" />

                        <Button Grid.Column="1" Content="Detectar" Style="{StaticResource ChipAccion}"
                                Margin="8,0,0,0" Command="{Binding DetectarCommand}"
                                ToolTip="Consulta a Google que modelos habilita tu API Key" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Guardar" Appearance="Primary" Padding="18,10" ToolTip="Guarda la clave de Gemini que escribiste arriba y la deja como la clave activa"
                                   Command="{Binding GuardarCommand}" />
                        <Button Content="Probar conexion" Style="{StaticResource ChipAccion}" ToolTip="Le hace una consulta minima a Gemini para ver si la clave sirve, sin generar ningun examen"
                                Margin="10,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ProbarCommand}" />
                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="12,0,0,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding Ocupado, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ui:InfoBar Margin="0,18,0,0" IsClosable="True"
                                Title="{Binding MensajeTitulo}" Message="{Binding Mensaje}"
                                Severity="{Binding Severidad, Converter={StaticResource Severidad}}"
                                IsOpen="{Binding MensajeTitulo, Converter={StaticResource TextoAVisibilidad},
                                         Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Aspecto: es lo unico ademas de la clave que se toca seguido -->
            <Border Style="{StaticResource TarjetaPlana}" Margin="0,0,0,16" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tema oscuro" Style="{StaticResource TxtCuerpo}" />
                        <TextBlock Text="Fondo tinta y texto atenuado, para sesiones largas de lectura."
                                   Style="{StaticResource TxtTenue}" />
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     AutomationProperties.Name="Tema oscuro"
                                     IsChecked="{Binding TemaOscuro, Mode=TwoWay}" />
                </Grid>
            </Border>

            <ui:CardExpander Icon="{ui:SymbolIcon Options24}" ContentPadding="18" Margin="0,0,0,20">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="Opciones avanzadas" Style="{StaticResource TxtCuerpo}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Solo si algo falla o queres afinar el rendimiento."
                                   Style="{StaticResource TxtTenue}" />
                    </StackPanel>
                </ui:CardExpander.Header>

                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PREGUNTAS POR PETICION" Style="{StaticResource TxtRotulo}" />
                            <ui:NumberBox Value="{Binding PreguntasPorLote, Mode=TwoWay}" Minimum="5" Maximum="15"
                                          ClearButtonEnabled="False"
                                          AutomationProperties.Name="Preguntas por peticion" />
                            <TextBlock Style="{StaticResource TxtTenue}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Minimo de preguntas por peticion, con tope de 15. El reparto busca la menor cantidad de llamadas: 30 preguntas salen en 2 lotes de 15, y 60 en 4. Si a Gemini se le corta la respuesta, la app baja el tamaño sola y hace mas viajes hasta completar el examen. Cada peticion descuenta de las 20 diarias por clave." />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PAGINAS POR BLOQUE" Style="{StaticResource TxtRotulo}" />
                            <ui:NumberBox Value="{Binding PaginasPorBloque, Mode=TwoWay}" Minimum="5" Maximum="40"
                                          ClearButtonEnabled="False"
                                          AutomationProperties.Name="Paginas por bloque" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MAXIMO DE CARACTERES" Style="{StaticResource TxtRotulo}" />
                            <ui:NumberBox Value="{Binding MaxCaracteres, Mode=TwoWay}" Minimum="10000" Maximum="300000"
                                          LargeChange="10000" SmallChange="5000" ClearButtonEnabled="False"
                                          AutomationProperties.Name="Maximo de caracteres de contexto" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MAXIMO DE IMAGENES" Style="{StaticResource TxtRotulo}" />
                            <ui:NumberBox Value="{Binding MaxImagenes, Mode=TwoWay}" Minimum="0" Maximum="30"
                                          ClearButtonEnabled="False"
                                          AutomationProperties.Name="Maximo de imagenes por examen" />
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding IncluirImagenes, Mode=TwoWay}" Margin="0,0,0,16"
                              Content="Extraer imagenes de los PDF por defecto" />

                    <Button Content="Abrir carpeta de datos" Style="{StaticResource ChipAccion}" ToolTip="Abre en el Explorador la carpeta donde AutoExam guarda tus materiales, examenes y ajustes"
                            HorizontalAlignment="Left" Command="{Binding AbrirCarpetaCommand}" />

                    <TextBlock Text="{Binding CarpetaDatos}" Style="{StaticResource TxtDato}"
                               FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardExpander>

            <!-- Actualizaciones: se comprueba sola al arrancar, esto es para no tener que reiniciar -->
            <Border Style="{StaticResource TarjetaPlana}" Margin="0,0,0,24" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TxtCuerpo}"
                                   Text="{Binding VersionActual, StringFormat='AutoExam {0}'}" />
                        <TextBlock Text="Busca versiones nuevas sola cada vez que abris la app."
                                   Style="{StaticResource TxtTenue}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- US-040: el boton va pegado al numero de version, que es donde alguien
                         que acaba de ver "AutoExam 1.1.0" se pregunta que trae. -->
                    <Button Grid.Column="1" Content="Notas de versión" Style="{StaticResource ChipAccion}"
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            ToolTip="Qué se agregó, cambió y arregló en esta versión y en las anteriores"
                            Command="{Binding AlternarNotasCommand}" />

                    <Button Grid.Column="2" Content="Buscar actualizaciones" ToolTip="Consulta si hay una version mas nueva de AutoExam publicada y te ofrece instalarla"
                            Style="{StaticResource ChipAccion}" VerticalAlignment="Center"
                            Margin="10,0,0,0" Command="{Binding BuscarActualizacionCommand}" />
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- US-040 — notas de version                                     -->
            <!--                                                               -->
            <!-- El contenido sale de CHANGELOG.md, embebido en el ejecutable  -->
            <!-- al compilar (RN-51): se lee sin conexion, que es justo cuando  -->
            <!-- se lo quiere leer, despues de que la app se actualizo sola.    -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource TarjetaResumen}" Margin="0,0,0,24" Padding="20,18"
                    Visibility="{Binding MostrarNotas, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Notas de versión" Style="{StaticResource TxtCuerpo}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />

                        <Button Content="Cerrar" Style="{StaticResource ChipAccion}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding AlternarNotasCommand}" />
                    </Grid>

                    <!-- Un build de prueba entre dos releases todavia no tiene su entrada.
                         Se dice; una seccion vacia se lee como una falla de la app. -->
                    <ui:InfoBar IsOpen="{Binding FaltanNotasDeEstaVersion, Mode=OneWay}"
                                IsClosable="False" Severity="Informational" Title=""
                                Margin="0,8,0,4"
                                Message="{Binding AvisoSinNotas}" />

                    <TextBlock Style="{StaticResource TxtAyuda}"
                               Visibility="{Binding HayNotas, Converter={StaticResource BoolToVis}}"
                               Text="Lo más nuevo arriba. Las versiones anteriores a la primera de esta lista se publicaron sin notas." />

                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Versiones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type servicios:NotasDeUnaVersion}">
                                    <Border Style="{StaticResource TarjetaPlana}" Padding="16,14"
                                            Margin="0,0,4,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Encabezado}" Style="{StaticResource TxtCuerpo}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource TxtTenue}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding Subtitulo, Converter={StaticResource TextoAVisibilidad}}" />

                                            <ItemsControl ItemsSource="{Binding Grupos}" Margin="0,10,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type servicios:GrupoDeNotas}">
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Titulo}"
                                                                       Style="{StaticResource TxtRotulo}" />

                                                            <ItemsControl ItemsSource="{Binding Puntos}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,5">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Vinieta propia: los puntos son
                                                                                 texto plano, sin el "- " del
                                                                                 archivo. -->
                                                                            <Ellipse Grid.Column="0" Width="4" Height="4"
                                                                                     VerticalAlignment="Top" Margin="2,8,10,0"
                                                                                     Fill="{DynamicResource PincelMarca}" />

                                                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                                                       Style="{StaticResource TxtSuave}"
                                                                                       TextWrapping="Wrap" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
