<UserControl x:Class="AutoExam.Views.AsistenteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:beh="clr-namespace:AutoExam.Behaviors"
             xmlns:modelos="clr-namespace:AutoExam.Models"
             xmlns:servicios="clr-namespace:AutoExam.Services"
             xmlns:vm="clr-namespace:AutoExam.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AsistenteViewModel}">

    <Grid MaxWidth="820" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="&#x1F4DD; Nuevo examen" Style="{StaticResource TxtSeccion}" Margin="0,0,0,18" />

        <!-- ============================================================ -->
        <!-- Riel de pasos. El subtitulo de cada paso no repite su nombre: -->
        <!-- muestra lo que el usuario ya eligio ahi.                      -->
        <!-- ============================================================ -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Pasos}" Margin="0,0,0,22">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PasoAsistente}">
                    <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0"
                            HorizontalContentAlignment="Stretch" Cursor="Hand"
                            AutomationProperties.Name="{Binding Titulo}"
                            Command="{Binding DataContext.IrAPasoCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Numero}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Background="Transparent">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="Circulo" Grid.Column="0" Width="22" Height="22"
                                                CornerRadius="11" HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource PincelBordeFuerte}"
                                                BorderThickness="1.5">
                                            <TextBlock x:Name="Numero" Text="{Binding Numero}"
                                                       FontFamily="{DynamicResource FuenteDato}" FontSize="11"
                                                       Foreground="{DynamicResource PincelTextoSuave}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock x:Name="Titulo" Grid.Column="1" Text="{Binding Titulo}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource FuenteCuerpo}"
                                                   FontSize="{DynamicResource TamCuerpo}"
                                                   Foreground="{DynamicResource PincelTextoSuave}" />
                                    </Grid>

                                    <!-- Indicador de avance (US-011 superficie 3 de RN-7). La base
                                         gris se pinta siempre; encima, LineaAvance (color marca)
                                         "crece" de izquierda a derecha via ScaleTransform.X cuando
                                         el paso queda activo o atras. No se anima Brush (restriccion
                                         del tech-spec): solo la escala. Con "reducir movimiento" del
                                         SO activo, ScaleX salta a 1 sin animar (NFR-47). -->
                                    <Grid Height="3">
                                        <Border x:Name="Linea" CornerRadius="2"
                                                Background="{DynamicResource PincelBorde}" />
                                        <Border x:Name="LineaAvance" CornerRadius="2"
                                                Background="{DynamicResource PincelMarca}"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="EscalaAvance" ScaleX="0" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Resumen}" Style="{StaticResource TxtTenue}"
                                               Margin="0,8,12,0" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                </StackPanel>

                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Completado}" Value="True">
                                        <Setter TargetName="Circulo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                                        <Setter TargetName="Circulo" Property="Background" Value="{DynamicResource PincelMarcaSuave}" />
                                        <Setter TargetName="Numero" Property="Foreground" Value="{DynamicResource PincelMarcaFuerte}" />
                                        <!-- Linea llena para un paso ya hecho: sin animar (al llegar aca
                                             viniendo de "actual" ya estaba en 1; si se salto directo, un
                                             snap es aceptable). -->
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="AvanceCompletado">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="EscalaAvance"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     To="1" Duration="0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="AvanceCompletado" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EsActual}" Value="True">
                                        <Setter TargetName="Circulo" Property="Background" Value="{DynamicResource PincelMarca}" />
                                        <Setter TargetName="Circulo" Property="BorderBrush" Value="{DynamicResource PincelMarca}" />
                                        <Setter TargetName="Numero" Property="Foreground" Value="{DynamicResource PincelSobreMarca}" />
                                        <Setter TargetName="Titulo" Property="Foreground" Value="{DynamicResource PincelTexto}" />
                                        <Setter TargetName="Titulo" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>

                                    <!-- US-011 superficie 3 / NFR-47. La linea de avance (LineaAvance)
                                         se controla SOLO por Storyboard sobre EscalaAvance.ScaleX
                                         (un ScaleTransform es Freezable: no se puede apuntar con un
                                         Setter, solo con Storyboard.TargetName). Tres casos:
                                         · paso actual + reducir-movimiento OFF -> crece 0->1 con la
                                           duracion/suavizado centralizados de Theme/Estilos.xaml;
                                         · paso actual + reducir-movimiento ON -> salta a 1 (Duration 0);
                                         · paso completado -> queda en 1 (Duration 0), sin re-animar al
                                           avanzar de actual a completado.
                                         Al retroceder, el ExitActions quita el Storyboard y la linea
                                         vuelve a ScaleX=0 (base gris). No se anima Brush/Color. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding EsActual}" Value="True" />
                                            <Condition Binding="{Binding Source={x:Static beh:Animaciones.Reducidas}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="AvanceActualAnimado">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="EscalaAvance"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     From="0" To="1"
                                                                     Duration="{StaticResource DuracionTransicionSeccion}"
                                                                     EasingFunction="{StaticResource SuavizadoSalida}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="AvanceActualAnimado" />
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding EsActual}" Value="True" />
                                            <Condition Binding="{Binding Source={x:Static beh:Animaciones.Reducidas}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="AvanceActualDirecto">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="EscalaAvance"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     To="1" Duration="0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                        <MultiDataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="AvanceActualDirecto" />
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============================================================ -->
        <!-- Contenido del paso                                            -->
        <!-- ============================================================ -->
        <!--
            US-030 — el paso se centra a lo alto cuando no llena la ventana.

            El paso de Formato son tres campos; maximizada, la app dejaba media pantalla
            vacia abajo con todo apretado contra el riel de pasos. Poner VerticalAlignment
            Center a secas no hace nada acá: un ScrollViewer mide su contenido con alto
            infinito, asi que el Grid termina midiendo exactamente lo que ocupa y no le queda
            espacio sobrante que repartir.

            Atar MinHeight al alto visible del propio ScrollViewer es lo que le da ese
            espacio: cuando el paso entra, el Grid ocupa toda la ventana y centra; cuando no
            entra (el paso de Material con veinte documentos), MinHeight queda por debajo del
            alto real, no aplica, y scrollea como siempre desde arriba.
        -->
        <ScrollViewer x:Name="AreaDelPaso" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Padding="0,0,12,0">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=AreaDelPaso}">

                <!-- PASO 1: material -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Paso}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- ============================================================ -->
                    <!-- US-026 / RN-29 — de donde salen las preguntas.                -->
                    <!--                                                               -->
                    <!-- Este es el punto de entrada principal del repaso combinado:    -->
                    <!-- esta siempre disponible aca, se haya llegado desde el inicio o -->
                    <!-- desde el Historial. El atajo del Historial lleva al mismo      -->
                    <!-- flujo, no a otra pantalla.                                     -->
                    <!-- ============================================================ -->
                    <TextBlock Text="¿De donde salen las preguntas?" Style="{StaticResource TxtCuerpo}"
                               Margin="0,0,0,12" />

                    <UniformGrid Columns="2" Margin="0,0,0,20">
                        <RadioButton Style="{StaticResource Chip}" GroupName="OrigenPreguntas"
                                     MinHeight="70" Margin="0,0,6,0"
                                     HorizontalContentAlignment="Stretch"
                                     IsChecked="{Binding ModoMaterial, Mode=OneWay}"
                                     Command="{Binding UsarMaterialCommand}"
                                     AutomationProperties.Name="Generar preguntas nuevas con IA a partir de material">
                            <StackPanel>
                                <TextBlock Text="Material nuevo" FontWeight="SemiBold" />
                                <TextBlock Text="Genera preguntas con IA desde tus libros y apuntes. Usa cuota."
                                           Style="{StaticResource TxtTenue}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Chip}" GroupName="OrigenPreguntas"
                                     MinHeight="70" Margin="6,0,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     IsChecked="{Binding ModoCombinado, Mode=OneWay}"
                                     Command="{Binding UsarExamenesAnterioresCommand}"
                                     AutomationProperties.Name="Combinar examenes que ya rendiste">
                            <StackPanel>
                                <TextBlock Text="Examenes anteriores" FontWeight="SemiBold" />
                                <TextBlock Text="Mezcla preguntas de examenes que ya rendiste. Instantaneo y sin cuota."
                                           Style="{StaticResource TxtTenue}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <!-- US-032 — repaso inteligente. Comparte fila con los otros origenes
                             porque responde la misma pregunta: de donde salen las preguntas. -->
                        <RadioButton Style="{StaticResource Chip}" GroupName="OrigenPreguntas"
                                     MinHeight="70" Margin="0,12,6,0"
                                     HorizontalContentAlignment="Stretch"
                                     IsChecked="{Binding ModoFalladas, Mode=OneWay}"
                                     Command="{Binding UsarPreguntasFalladasCommand}"
                                     AutomationProperties.Name="Repasar solo las preguntas que fallaste">
                            <StackPanel>
                                <TextBlock Text="Lo que falle" FontWeight="SemiBold" />
                                <TextBlock Text="Solo las preguntas que erraste o salteaste y todavia no acertaste."
                                           Style="{StaticResource TxtTenue}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <!-- US-037 — un examen que compartio un compañero. -->
                        <RadioButton Style="{StaticResource Chip}" GroupName="OrigenPreguntas"
                                     MinHeight="70" Margin="6,12,0,0"
                                     HorizontalContentAlignment="Stretch"
                                     IsChecked="{Binding ModoImportado, Mode=OneWay}"
                                     Command="{Binding UsarExamenImportadoCommand}"
                                     AutomationProperties.Name="Rendir un examen que te compartieron">
                            <StackPanel>
                                <TextBlock Text="Examen compartido" FontWeight="SemiBold" />
                                <TextBlock Text="Un examen que te paso un compañero. No gasta tu cuota de Gemini."
                                           Style="{StaticResource TxtTenue}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!-- ============================================================ -->
                    <!-- US-032 — elegir de que materia o documento repasar lo fallado  -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding ModoFalladas, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ResumenFalladas}" Style="{StaticResource TxtSuave}"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding FocosDeRepaso}"
                                      Visibility="{Binding HayPreguntasFalladas, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type servicios:FocoDeRepaso}">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FocoDeRepaso"
                                                 Content="{Binding Etiqueta}"
                                                 AutomationProperties.Name="{Binding Etiqueta}"
                                                 Command="{Binding DataContext.ElegirFocoCommand,
                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 CommandParameter="{Binding}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource SonIguales}" Mode="OneWay">
                                                <Binding Path="Clave" />
                                                <Binding Path="DataContext.FocoElegido.Clave"
                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- US-037 — examenes importados                                  -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding ModoImportado, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ResumenImportado}" Style="{StaticResource TxtSuave}"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                        <Button Content="Importar un examen" Style="{StaticResource ChipAccion}"
                                HorizontalAlignment="Left" Margin="0,0,0,12"
                                Command="{Binding ImportarExamenCommand}"
                                ToolTip="Abre un archivo de examen que te compartieron y lo guarda para rendirlo cuando quieras" />

                        <ListBox ItemsSource="{Binding ExamenesImportados}" MaxHeight="280"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ItemLibro}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Examenes importados">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type servicios:ExamenImportado}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <RadioButton Grid.Column="0" GroupName="ExamenImportado"
                                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{Binding Titulo}"
                                                     Command="{Binding DataContext.ElegirImportadoCommand,
                                                               RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                     CommandParameter="{Binding}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource SonIguales}" Mode="OneWay">
                                                    <Binding Path="Ruta" />
                                                    <Binding Path="DataContext.ImportadoElegido.Ruta"
                                                             RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                        </RadioButton>

                                        <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,10,0"
                                                HorizontalAlignment="Right" Visibility="Collapsed"
                                                Background="{Binding ColorMateria, Converter={StaticResource ColorMateria}}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource TxtCuerpo}" />
                                            <TextBlock Text="{Binding Detalle}" Style="{StaticResource TxtTenue}" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Quitar" Style="{StaticResource ChipAccion}"
                                                VerticalAlignment="Center"
                                                ToolTip="Saca este examen de tus importados. No afecta al historial"
                                                Command="{Binding DataContext.QuitarImportadoCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- Modo repaso: elegir los examenes a combinar                   -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding ModoCombinado, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ResumenRepaso}" Style="{StaticResource TxtSuave}"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- Buscador: el historial puede tener cientos de intentos, y sin
                             filtro elegir dos de una materia concreta seria bajar por una
                             lista larguisima. -->
                        <ui:TextBox Text="{Binding FiltroExamenes, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Buscar por examen o materia..."
                                    Icon="{ui:SymbolIcon Search24}"
                                    AutomationProperties.Name="Buscar entre los examenes rendidos"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding HayExamenesParaRepaso, Converter={StaticResource BoolToVis}}" />

                        <ListBox ItemsSource="{Binding ExamenesParaRepaso}" MaxHeight="320"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ItemLibro}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Examenes rendidos para combinar">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type modelos:ExamenRendido}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding TituloTexto}" />

                                        <!-- Franja del color de la materia (US-027 / RN-34):
                                             el mismo que usan la biblioteca y el historial. -->
                                        <Border Grid.Column="1" Width="3" Height="26" CornerRadius="2"
                                                Margin="0,0,10,0" VerticalAlignment="Center"
                                                Background="{Binding ColorMateria, Converter={StaticResource ColorMateria}}" />

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TituloTexto}" Style="{StaticResource TxtCuerpo}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource TxtTenue}">
                                                <Run Text="{Binding Materia, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding FechaTexto, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Style="{StaticResource TxtDato}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Text="{Binding TotalPreguntas, StringFormat='{}{0} preg.'}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Content="Destildar todos" Style="{StaticResource ChipAccion}" ToolTip="Destilda todos los examenes elegidos y deja la seleccion vacia"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding DestildarExamenesCommand}"
                                Visibility="{Binding HayExamenesParaRepaso, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- Modo material: lo de siempre                                   -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding ModoMaterial, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="¿De que material?" Style="{StaticResource TxtCuerpo}" Margin="0,0,0,14" />

                    <!-- ============================================================ -->
                    <!-- US-024 — Materia primero, despues los documentos.             -->
                    <!--                                                               -->
                    <!-- Filtrar por materia no es solo comodidad: es lo que hace      -->
                    <!-- cumplir RN-23 por construccion, porque nunca llegan a verse   -->
                    <!-- juntos dos documentos de materias distintas para poder        -->
                    <!-- tildarlos a la vez.                                           -->
                    <!-- ============================================================ -->
                    <TextBlock Text="MATERIA" Style="{StaticResource TxtRotulo}"
                               Visibility="{Binding HayLibros, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Materias}" Margin="0,0,0,16"
                                  Visibility="{Binding HayLibros, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Chip}"
                                             GroupName="MateriasAsistente"
                                             AutomationProperties.Name="{Binding Nombre}"
                                             Command="{Binding DataContext.ElegirMateriaCommand,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding Nombre}">
                                    <RadioButton.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Fill="{Binding Color, Converter={StaticResource ColorMateria}}" />
                                            <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton.Content>
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource SonIguales}" Mode="OneWay">
                                            <Binding Path="Nombre" />
                                            <Binding Path="DataContext.MateriaElegida"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource TxtAyuda}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HayLibros, Converter={StaticResource BoolToVis}}"
                               Text="Tilda uno o varios documentos para combinarlos en un mismo examen. Sin ninguno tildado se usa el que este resaltado." />

                    <ListBox ItemsSource="{Binding LibrosDeLaMateria}" MaxHeight="300"
                             SelectedItem="{Binding Libro, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ItemLibro}"
                             Background="Transparent" BorderThickness="0" Margin="0,0,0,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Documentos para el examen"
                             Visibility="{Binding HayLibros, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type modelos:Libro}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- El tilde decide que entra al examen; la fila
                                         resaltada decide de cual se ven los capitulos en el
                                         paso Alcance. Son dos cosas distintas y por eso son
                                         dos controles distintos (US-024). -->
                                    <CheckBox Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                              IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Titulo}"
                                              ToolTip="Incluir este documento en el examen" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource TxtCuerpo}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Materia}" Style="{StaticResource TxtTenue}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Style="{StaticResource TxtDato}"
                                               VerticalAlignment="Center"
                                               Text="{Binding MedidaTamanio}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding ResumenSeleccion}" Style="{StaticResource TxtSuave}"
                               Margin="0,0,0,16" TextWrapping="Wrap"
                               Visibility="{Binding HayLibros, Converter={StaticResource BoolToVis}}" />

                    <Button Style="{StaticResource ZonaSoltar}"
                            Command="{Binding ElegirArchivoCommand}"
                            AutomationProperties.Name="Agregar material nuevo: PDF, Word, Excel, PowerPoint o imagenes. Solta los archivos o hace click"
                            beh:SoltarArchivo.Comando="{Binding SoltarCommand}"
                            beh:SoltarArchivo.Extensiones=".pdf .docx .xlsx .pptx .jpg .jpeg .png .heic .heif">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Solta un PDF, Word, Excel, PowerPoint o varias imagenes" Style="{StaticResource TxtCuerpo}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="o hace click para elegirlos" Style="{StaticResource TxtTenue}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"
                                Visibility="{Binding Agregando, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" />
                        <TextBlock Text="Analizando el material..." Style="{StaticResource TxtSuave}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- PASO 2: alcance -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Paso}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Capitulos y rango de paginas son solo para PDF (US-009 AC-T45). Para
                         Word/Excel/PowerPoint/imagenes el examen toma el material completo y
                         solo se acota con el eje tematico. -->
                    <TextBlock Style="{StaticResource TxtSuave}" Margin="0,0,0,4"
                               Visibility="{Binding EsFuentePdf, Converter={StaticResource BoolToVis}, ConverterParameter=invertir}"
                               Text="Este material se toma completo. Para acotar el examen, usa el eje tematico de abajo." />

                    <!-- US-024: con varios documentos, los capitulos que se ven aca son los
                         del documento resaltado en el paso Material. Para acotar otro, se
                         vuelve atras y se lo resalta. El eje tematico si vale para todos. -->
                    <Border Style="{StaticResource TarjetaPlana}" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding EsExamenCombinado, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TxtCuerpo}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="{Binding ResumenSeleccion}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource TxtTenue}" TextWrapping="Wrap"
                                       Text="Cada documento entra completo, salvo los capitulos que le hayas marcado. Los capitulos de abajo son los del documento resaltado en el paso Material: para acotar otro, volve y resaltalo. El eje tematico vale para todos." />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding EsFuentePdf, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="CAPITULOS" Style="{StaticResource TxtRotulo}" />
                    <TextBlock Style="{StaticResource TxtAyuda}"
                               Text="Toca los que quieras y se combinan, salteados incluidos (1, 2, 5, 7...). Sin ninguno marcado entra el libro entero." />

                    <!-- Sin capitulos cargados los chips no existen y la pantalla parece
                         rota: hay que decir por que no hay nada y como conseguirlos. -->
                    <Border Style="{StaticResource TarjetaPlana}" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding HayModulos, Converter={StaticResource BoolToVis},
                                         ConverterParameter=invertir}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TxtSuave}" Margin="0,0,0,10"
                                       Text="Este libro todavia no tiene capitulos cargados, asi que solo podes elegir por paginas." />
                            <Button Content="Detectarlos ahora desde el indice del PDF" ToolTip="Lee el indice del PDF para armar la lista de capitulos: no genera preguntas ni gasta cuota"
                                    Style="{StaticResource ChipAccion}" HorizontalAlignment="Left"
                                    Command="{Binding DetectarCapitulosCommand}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Modulos}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Los chips se acomodan en varias filas: nunca se recorta
                                     una etiqueta ni se esconde un modulo. -->
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type modelos:Modulo}">
                                <ToggleButton Style="{StaticResource Chip}"
                                              IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Nombre}"
                                              ToolTip="{Binding Descripcion}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nombre}" />
                                        <TextBlock Text="{Binding CantidadPaginas, StringFormat=' · {0}p'}"
                                                   FontFamily="{DynamicResource FuenteDato}" FontSize="11"
                                                   Opacity="0.7" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24"
                                Visibility="{Binding HayModulos, Converter={StaticResource BoolToVis}}">
                        <Button Content="Marcar todos" Style="{StaticResource ChipAccion}" ToolTip="Incluye todos los capitulos en el examen"
                                Command="{Binding MarcarTodosCommand}" />
                        <Button Content="Ninguno" Style="{StaticResource ChipAccion}" ToolTip="Desmarca todos los capitulos: sin ninguno marcado entra el libro entero"
                                Command="{Binding DesmarcarTodosCommand}" />
                        <TextBlock Text="{Binding ResumenCapitulos}" Style="{StaticResource TxtTenue}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="PAGINAS" Style="{StaticResource TxtRotulo}" />
                    <WrapPanel Margin="0,0,0,4">
                        <RadioButton Style="{StaticResource Chip}" Content="Todo el libro"
                                      IsChecked="{Binding PresetRango, Converter={StaticResource IndiceOpcion},
                                                  ConverterParameter=0, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="Primeras 50"
                                      IsChecked="{Binding PresetRango, Converter={StaticResource IndiceOpcion},
                                                  ConverterParameter=1, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="Ultimas 50"
                                      IsChecked="{Binding PresetRango, Converter={StaticResource IndiceOpcion},
                                                  ConverterParameter=2, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="Elegir rango"
                                      IsChecked="{Binding PresetRango, Converter={StaticResource IndiceOpcion},
                                                  ConverterParameter=3, Mode=TwoWay}" />
                    </WrapPanel>

                    <!-- Los numeros aparecen solo si el usuario los pidio -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,24"
                                Visibility="{Binding RangoAMano, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Desde" Style="{StaticResource TxtSuave}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ui:NumberBox Value="{Binding Desde, Mode=TwoWay}" Minimum="1" Maximum="100000"
                                      Width="110" ClearButtonEnabled="False"
                                      AutomationProperties.Name="Pagina desde" />
                        <TextBlock Text="hasta" Style="{StaticResource TxtSuave}" VerticalAlignment="Center"
                                   Margin="14,0,8,0" />
                        <ui:NumberBox Value="{Binding Hasta, Mode=TwoWay}" Minimum="1" Maximum="100000"
                                      Width="110" ClearButtonEnabled="False"
                                      AutomationProperties.Name="Pagina hasta" />
                    </StackPanel>
                    </StackPanel>

                    <TextBlock Text="EJE TEMATICO (OPCIONAL)" Style="{StaticResource TxtRotulo}" />
                    <ui:TextBox Text="{Binding Tema, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Potenciales de accion, arritmias..."
                                AutomationProperties.Name="Eje tematico" />
                    <TextBlock Style="{StaticResource TxtAyuda}"
                               Text="Acota las preguntas a un tema puntual dentro de las paginas elegidas." />
                </StackPanel>

                <!-- PASO 3: formato -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Paso}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="CUANTAS PREGUNTAS" Style="{StaticResource TxtRotulo}" />
                    <WrapPanel Margin="0,0,0,4">
                        <RadioButton Style="{StaticResource Chip}" Content="10"
                                      IsChecked="{Binding PresetCantidad, Converter={StaticResource IndiceOpcion},
                                                  ConverterParameter=10, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="30"
                                      IsChecked="{Binding PresetCantidad, Converter={StaticResource IndiceOpcion},
                                                  ConverterParameter=30, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="60"
                                      IsChecked="{Binding PresetCantidad, Converter={StaticResource IndiceOpcion},
                                                  ConverterParameter=60, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="Otra"
                                      IsChecked="{Binding PresetCantidad, Converter={StaticResource IndiceOpcion},
                                                  ConverterParameter=-1, Mode=TwoWay}" />
                        <ui:NumberBox Value="{Binding CantidadPersonalizada, Mode=TwoWay}" Minimum="1" Maximum="120"
                                      Width="100" ClearButtonEnabled="False" Margin="4,0,0,8"
                                      AutomationProperties.Name="Cantidad de preguntas"
                                      Visibility="{Binding CantidadAMano, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>

                    <!-- Solo aplica al modo material: un repaso no genera preguntas, las
                         toma de examenes ya rendidos, asi que no hay nada que pedirle a la
                         IA sobre imagenes (US-026). -->
                    <CheckBox IsChecked="{Binding IncluirImagenes, Mode=TwoWay}" Margin="0,14,0,24"
                              Content="Incluir preguntas sobre graficos e imagenes del material"
                              Visibility="{Binding ModoMaterial, Converter={StaticResource BoolToVis}}" />

                    <Border Style="{StaticResource TarjetaResumen}" Padding="16" Margin="0,14,0,20"
                            Visibility="{Binding ModoCombinado, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ResumenRepaso}" Style="{StaticResource TxtCuerpo}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource TxtTenue}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Las preguntas salen mezcladas al azar y ninguna se repite. Es instantaneo: no usa la IA ni gasta cuota, porque ya estaban generadas." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TarjetaResumen}" Padding="16" Margin="0,14,0,20"
                            Visibility="{Binding ModoFalladas, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ResumenFalladas}" Style="{StaticResource TxtCuerpo}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource TxtTenue}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Entran solo las que erraste o salteaste y todavia no volviste a acertar. Si acertas una en este repaso, deja de aparecer." />
                        </StackPanel>
                    </Border>

                    <!-- ============================================================ -->
                    <!-- US-034 — cronometro                                           -->
                    <!--                                                               -->
                    <!-- RN-43: vive en el paso Formato y no en un modo puntual, asi    -->
                    <!-- que la misma opcion vale para un examen generado con IA, uno   -->
                    <!-- combinado, un repaso de lo fallado y uno importado.            -->
                    <!-- ============================================================ -->
                    <TextBlock Text="TIEMPO" Style="{StaticResource TxtRotulo}" />
                    <TextBlock Style="{StaticResource TxtAyuda}"
                               Text="Es un limite para TODO el examen, no por pregunta: cuanto gastar en cada una es parte de lo que se practica. Al acabarse, se entrega solo con lo que hayas respondido." />

                    <WrapPanel Margin="0,0,0,4">
                        <RadioButton Style="{StaticResource Chip}" Content="Sin limite"
                                     GroupName="TiempoLimite"
                                     AutomationProperties.Name="Sin limite de tiempo"
                                     IsChecked="{Binding MinutosLimite, Converter={StaticResource IndiceOpcion},
                                                 ConverterParameter=0, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="20 min" GroupName="TiempoLimite"
                                     IsChecked="{Binding MinutosLimite, Converter={StaticResource IndiceOpcion},
                                                 ConverterParameter=20, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="40 min" GroupName="TiempoLimite"
                                     IsChecked="{Binding MinutosLimite, Converter={StaticResource IndiceOpcion},
                                                 ConverterParameter=40, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="60 min" GroupName="TiempoLimite"
                                     IsChecked="{Binding MinutosLimite, Converter={StaticResource IndiceOpcion},
                                                 ConverterParameter=60, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Chip}" Content="90 min" GroupName="TiempoLimite"
                                     IsChecked="{Binding MinutosLimite, Converter={StaticResource IndiceOpcion},
                                                 ConverterParameter=90, Mode=TwoWay}" />
                    </WrapPanel>

                    <!-- Un valor a mano, para el que practica con el tiempo real de su parcial. -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                        <ui:NumberBox Value="{Binding MinutosLimite, Mode=TwoWay}"
                                      Minimum="0" Maximum="300" ClearButtonEnabled="False"
                                      Width="130"
                                      AutomationProperties.Name="Minutos de tiempo limite"
                                      ToolTip="Minutos totales para todo el examen. 0 = sin limite" />
                        <TextBlock Text="{Binding ResumenTiempo}" Style="{StaticResource TxtSuave}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Resumen antes de gastar cuota: que entra, cuanto y con que.
                         US-030: es el "resumen final" que nombra el criterio, asi que va en el
                         nivel de profundidad mas alto. Es lo ultimo que hay que leer antes de
                         apretar generar, y hasta ahora se veia igual que los dos bloques
                         informativos de arriba. -->
                    <!-- Solo en modo material: en los otros tres no hay libro ni alcance, y
                         este bloque terminaba diciendo "10 preguntas de" seguido de nada, mas
                         un "Elegi un material para empezar" en una pantalla donde no se elige
                         material. Cada modo local ya trae su propio resumen arriba. -->
                    <Border Style="{StaticResource TarjetaResumen}" Margin="0,0,0,20"
                            Visibility="{Binding ModoMaterial, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Vas a generar" Style="{StaticResource TxtRotulo}" />

                            <TextBlock Style="{StaticResource TxtCuerpo}" Margin="0,0,0,10">
                                <Run Text="{Binding Cantidad, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="preguntas de" />
                                <Run Text="{Binding Libro.Titulo, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>

                            <TextBlock Text="{Binding ResumenAlcance}" Style="{StaticResource TxtSuave}" />
                            <TextBlock Style="{StaticResource TxtDato}" Margin="0,6,0,0"
                                       Visibility="{Binding EsFuentePdf, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding PaginasDelAlcance, StringFormat='~{0} paginas de material'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- Barra de accion                                               -->
        <!-- ============================================================ -->
        <ui:InfoBar Grid.Row="3" IsClosable="True" Margin="0,16,0,0" Title=""
                    Message="{Binding Mensaje}"
                    IsOpen="{Binding HayMensaje, Mode=OneWay}"
                    Severity="{Binding Severidad, Converter={StaticResource Severidad}}" />

        <Grid Grid.Row="4" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Atras" Style="{StaticResource ChipAccion}" ToolTip="Vuelve al paso anterior sin perder lo que ya elegiste"
                    VerticalAlignment="Center" Command="{Binding AnteriorCommand}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding Generando, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" />
                <TextBlock Text="{Binding Progreso}" Style="{StaticResource TxtSuave}"
                           VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="360" />
                <Button Content="Cancelar" Style="{StaticResource ChipAccion}" Margin="12,0,0,0" ToolTip="Corta la generacion en curso"
                        Command="{Binding CancelarCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Continuar" Appearance="Primary" ToolTip="Pasa al siguiente paso del asistente" Padding="22,11" FontSize="14"
                           Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding SiguienteCommand}"
                           Visibility="{Binding EsUltimoPaso, Converter={StaticResource BoolAVisibilidad},
                                        ConverterParameter=invertir}" />

                <ui:Button Content="Generar examen" Appearance="Primary" ToolTip="{Binding AvisoDeGeneracion}" Padding="22,11" FontSize="14"
                           Icon="{ui:SymbolIcon Sparkle24}" Command="{Binding GenerarCommand}"
                           Visibility="{Binding EsUltimoPaso, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
